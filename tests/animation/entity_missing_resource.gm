global AnimProbe=function(name,value) {
    GameMonkeyScript.loadScript("OEP__"+name+"__"+value+".gm");
};

local entity=EntityManager.createEntity();
local missing=entity.loadAnimation("Platformer/gameAssets/openegg_probe_missing.fsa");
AnimProbe("Entity.loadAnimation.missingResource",missing.getNumImages());
entity.unloadAnimation(missing);

global Main=function(p) {
    return table(Process=p,constructor=function(){},init=function(){return true;},
                 update=function(dt){});
};
