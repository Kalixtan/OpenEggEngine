global AnimProbe=function(name,value) {
    GameMonkeyScript.loadScript("OEP__"+name+"__"+value+".gm");
};

global anim=AnimationModule.loadAnimation(
    "Platformer/gameAssets/checkpointTriggeredInactive.fsa");
anim.finishLoad();
AnimProbe("Animation.getNumImages.initial",anim.getNumImages());
AnimProbe("Animation.getNumFrames.initial",anim.getNumFrames());
AnimProbe("Animation.getSourcePixelWidth.initial",anim.getSourcePixelWidth());
AnimProbe("Animation.getSourcePixelHeight.initial",anim.getSourcePixelHeight());
AnimProbe("Animation.getCurrentFrame.initial",anim.getCurrentFrame());
AnimProbe("Animation.getPlayTime.initial",anim.getPlayTime());
AnimProbe("Animation.isPlaying.initial",anim.isPlaying());
AnimProbe("Animation.isPaused.initial",anim.isPaused());
AnimProbe("Animation.isDone.initial",anim.isDone());
local shared=AnimationModule.loadAnimation(
    "Platformer/gameAssets/checkpointTriggeredInactive.fsa");
AnimProbe("Animation.getNumImages.sharedResource",shared.getNumImages());

anim.setPlayTime(120);
anim.setPlayTimeSpeed(1.5);
anim.setPlayPosition(60);
AnimProbe("Animation.getPlayTime.changed",anim.getPlayTime());
AnimProbe("Animation.getPlayPosition.seek",anim.getPlayPosition());
AnimProbe("Animation.getCurrentFrame.seek",anim.getCurrentFrame());
anim.setCurrentFrame(0);
AnimProbe("Animation.getCurrentFrame.firstFrame",anim.getCurrentFrame());
anim.setCurrentFrame(1);
AnimProbe("Animation.getCurrentFrame.set",anim.getCurrentFrame());
anim.setCurrentFrame(35);
AnimProbe("Animation.getCurrentFrame.clampedFrame",anim.getCurrentFrame());
anim.play(1);
AnimProbe("Animation.isPlaying.play",anim.isPlaying());
AnimProbe("Animation.isPaused.play",anim.isPaused());
anim.pause();
AnimProbe("Animation.isPlaying.pause",anim.isPlaying());
AnimProbe("Animation.isPaused.pause",anim.isPaused());
anim.playOnce(1);
AnimProbe("Animation.isPlaying.playOnce",anim.isPlaying());
anim.setPlayPosition(120);
AnimProbe("Animation.isDone.end",anim.isDone());
AnimProbe("Animation.isPlaying.end",anim.isPlaying());
anim.setPlayPosition(0);
anim.setIsReversed(1);
AnimProbe("Animation.isReversed.true",anim.isReversed());
AnimProbe("Animation.getCurrentFrame.reversed",anim.getCurrentFrame());
anim.setIsReversed(0);
AnimProbe("Animation.isReversed.false",anim.isReversed());

local sequence={0,1,34,3};
anim.setAnimSequence(0,sequence);
AnimProbe("Animation.getNumFrames.customSequence",anim.getNumFrames());
AnimProbe("Animation.getNumFrames.sharedSequence",shared.getNumFrames());
anim.setPlayTime(4);
anim.setPlayPosition(0);
AnimProbe("Animation.getCurrentFrame.sequenceFirst",anim.getCurrentFrame());
anim.setPlayPosition(1);
AnimProbe("Animation.getCurrentFrame.sequenceSecond",anim.getCurrentFrame());

AnimationModule.unloadAnimation(anim);
AnimProbe("Animation.getNumImages.unloaded",anim.getNumImages());
AnimProbe("Animation.getNumImages.sharedStillLoaded",shared.getNumImages());
AnimationModule.unloadAll();
local fresh=AnimationModule.loadAnimation(
    "Platformer/gameAssets/checkpointTriggeredInactive.fsa");
AnimProbe("Animation.getNumImages.afterUnloadAll",fresh.getNumImages());
local missing=AnimationModule.loadAnimation("Platformer/gameAssets/openegg_probe_missing.fsa");
AnimProbe("Animation.getNumImages.missingResource",missing.getNumImages());
AnimationModule.unloadAnimation(shared);
AnimationModule.unloadAnimation(fresh);
AnimationModule.unloadAnimation(missing);

global animSlow=AnimationModule.loadAnimation(
    "Platformer/gameAssets/checkpointTriggeredInactive.fsa");
global animFast=AnimationModule.loadAnimation(
    "Platformer/gameAssets/checkpointTriggeredInactive.fsa");
animSlow.setPlayTime(2000);
animFast.setPlayTime(2000);
animSlow.setPlayTimeSpeed(0.5);
animFast.setPlayTimeSpeed(4.0);
animSlow.play(1);
animFast.play(1);

global Main=function(p) {
    return table(Process=p,frame=0,constructor=function(){},
        init=function(){return true;},update=function(dt){
            this.frame+=1;
            if (this.frame==30) {
                AnimProbe("Animation.getPlayPosition.slowSpeed",animSlow.getPlayPosition());
                AnimProbe("Animation.getPlayPosition.fastSpeed",animFast.getPlayPosition());
                AnimProbe("Animation.setPlayTimeSpeed.noEffect",
                    MATH_ABS(animSlow.getPlayPosition()-animFast.getPlayPosition())<0.01);
                AnimationModule.unloadAnimation(animSlow);
                AnimationModule.unloadAnimation(animFast);
            }
        });
};
