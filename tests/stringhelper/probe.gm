global Check=function(name,ok) {
    if (ok) { GameSystem.trace(name+" PASS"); }
    else { GameSystem.trace(name+" FAIL"); }
};

global Main=function(p) {
    return table(Process=p,ran=0,constructor=function() {},
        update=function() {
            if (this.ran) { return; }
            this.ran=1;

            Check("MakeTimeString uses the retail format and clamps time",
                STRINGHELPER_MakeTimeString(0)=="00:00.00" &&
                STRINGHELPER_MakeTimeString(65000)=="01:05.00" &&
                STRINGHELPER_MakeTimeString(65000.9)=="01:05.00" &&
                STRINGHELPER_MakeTimeString(125678)=="02:05.67" &&
                STRINGHELPER_MakeTimeString(-65000)=="01:05.00" &&
                STRINGHELPER_MakeTimeString(5639999)=="94:00.99" &&
                STRINGHELPER_MakeTimeString(6000000)=="99:00.00" &&
                STRINGHELPER_MakeTimeString(6061234)=="99:01.23");

            local timeTable=STRINGHELPER_MakeTimeTable(65000);
            Check("MakeTimeTable returns retail table and string types",
                typeName(timeTable)=="table" && tableCount(timeTable)==4 &&
                typeName(timeTable[0])=="string" && timeTable[0]=="%1:%2.%3" &&
                typeName(timeTable[1])=="table" && typeName(timeTable[2])=="table" &&
                typeName(timeTable[3])=="table" &&
                tableCount(timeTable[1])==1 && tableCount(timeTable[2])==1 &&
                tableCount(timeTable[3])==1 &&
                typeName(timeTable[1].untranslated)=="string" &&
                typeName(timeTable[2].untranslated)=="string" &&
                typeName(timeTable[3].untranslated)=="string");

            Check("MakeTimeTable formats minute second and hundredth slots",
                timeTable[1].untranslated=="01" &&
                timeTable[2].untranslated=="05" &&
                timeTable[3].untranslated=="00");

            local zeroTime=STRINGHELPER_MakeTimeTable(0);
            local minuteEdge=STRINGHELPER_MakeTimeTable(59999);
            local minuteCarry=STRINGHELPER_MakeTimeTable(60000);
            local maxTime=STRINGHELPER_MakeTimeTable(6000000);
            local negativeTime=STRINGHELPER_MakeTimeTable(-65000);
            local fractionalTime=STRINGHELPER_MakeTimeTable(125678.9);
            local floatEdge=STRINGHELPER_MakeTimeTable(5639999);
            local beforeFloatEdge=STRINGHELPER_MakeTimeTable(5639998);
            Check("MakeTimeTable handles zero boundaries clamp and sign",
                zeroTime[1].untranslated=="00" && zeroTime[2].untranslated=="00" &&
                zeroTime[3].untranslated=="00" &&
                minuteEdge[1].untranslated=="00" && minuteEdge[2].untranslated=="59" &&
                minuteEdge[3].untranslated=="99" &&
                minuteCarry[1].untranslated=="01" && minuteCarry[2].untranslated=="00" &&
                minuteCarry[3].untranslated=="00" &&
                maxTime[1].untranslated=="99" && maxTime[2].untranslated=="59" &&
                maxTime[3].untranslated=="99" &&
                negativeTime[1].untranslated=="01" && negativeTime[2].untranslated=="05" &&
                negativeTime[3].untranslated=="00" &&
                fractionalTime[1].untranslated=="02" &&
                fractionalTime[2].untranslated=="05" &&
                fractionalTime[3].untranslated=="67" &&
                beforeFloatEdge[1].untranslated=="93" &&
                beforeFloatEdge[2].untranslated=="59" &&
                beforeFloatEdge[3].untranslated=="99" &&
                floatEdge[1].untranslated=="94" &&
                floatEdge[2].untranslated=="00" &&
                floatEdge[3].untranslated=="99");

            Check("IsNumeric accepts only nonempty decimal digit strings",
                STRINGHELPER_IsNumeric("12345")==1 &&
                STRINGHELPER_IsNumeric("12a")==0 &&
                STRINGHELPER_IsNumeric("")==0);

            Check("Backspace removes one byte and handles empty strings",
                STRINGHELPER_Backspace("abc")=="ab" &&
                STRINGHELPER_Backspace("")=="");

            local source=table();
            source["zeta"]="beta";
            source["alpha"]="alpha";
            source["mu"]="delta";
            local keys=STRINGHELPER_SortAscending(source,0);
            local values=STRINGHELPER_SortAscending(source,1);
            Check("SortAscending sorts string keys or values",
                keys.size==3 && keys[0]=="alpha" && keys[1]=="mu" && keys[2]=="zeta" &&
                values.size==3 && values[0]=="alpha" && values[1]=="beta" && values[2]=="delta");

            local wrongType=STRINGHELPER_SortAscending(source,0.0);
            local extraArgs=STRINGHELPER_SortAscending(source,0,"ignored");
            Check("SortAscending reads selector only for exactly two integer arguments",
                wrongType[0]=="alpha" && wrongType[1]=="beta" &&
                extraArgs[0]=="alpha" && extraArgs[1]=="beta");

            Check("CopyAndSetChar uses zero-based byte indexes",
                STRINGHELPER_CopyAndSetChar(0,"X","abc")=="Xbc" &&
                STRINGHELPER_CopyAndSetChar(2,"X","abc")=="abX" &&
                STRINGHELPER_CopyAndSetChar(3,"X","abc")=="abc" &&
                STRINGHELPER_CopyAndSetChar(1.0,"X","abc")=="abc");

            Check("GetChar and GetSubString use raw integer argument slots",
                STRINGHELPER_GetChar(1,"abc")=="b" &&
                STRINGHELPER_GetChar(1.0,"abc")=="" &&
                STRINGHELPER_GetSubString(0,1,"abc")=="ab" &&
                STRINGHELPER_GetSubString(0.0,1.0,"abc")=="");

            Check("IsAlpha requires a one-byte string",
                STRINGHELPER_IsAlpha("A")==1 && STRINGHELPER_IsAlpha("ab")==0 &&
                STRINGHELPER_IsAlpha(65)==0);

            Check("Character predicates use retail byte arguments",
                STRINGHELPER_IsBackspace(8)==1 && STRINGHELPER_IsLowercase(97)==1 &&
                STRINGHELPER_IsUppercase(65)==1 && STRINGHELPER_IsAlphanumeric(57)==1 &&
                STRINGHELPER_IsWhitespace(32)==1 && STRINGHELPER_IsWhitespace(" ")==1 &&
                STRINGHELPER_IsWhitespace("ab")==0);

            Check("ConvertToInt handles decimal and invalid strings",
                STRINGHELPER_ConvertToInt("-123")==-123 &&
                STRINGHELPER_ConvertToInt("bad")==null);

            Check("ConvertToReal handles decimal and invalid strings",
                STRINGHELPER_ConvertToReal("-1.25")==-1.25 &&
                STRINGHELPER_ConvertToReal("bad")==null);

            Check("ConvertMSStringToSecondInt returns whole seconds",
                STRINGHELPER_ConvertMSStringToSecondInt("12345")==12 &&
                STRINGHELPER_ConvertMSStringToSecondInt("bad")==null);

            Check("Hex conversion reads and writes uppercase digits",
                STRINGHELPER_ConvertHexStringToInt("FF")==255 &&
                STRINGHELPER_MakeHexString(255)=="FF");

            Check("Occurrence helpers return one-based matches",
                STRINGHELPER_GetFirstOccurrence("a","banana")==2 &&
                STRINGHELPER_GetLastOccurrence("a","banana")==6 &&
                STRINGHELPER_GetFirstOccurrence("z","banana")==0 &&
                STRINGHELPER_GetLastOccurrence("z","banana")==0);

            Check("StringHelper_GetLength reads GameMonkey byte length",
                STRINGHELPER_GetLength("abc")==3 && STRINGHELPER_GetLength("")==0);

            Check("StringHelper prefix tests match case and spacing rules",
                STRINGHELPER_BeginsWith("prefix","pre")==1 &&
                STRINGHELPER_BeginsWith("pre","prefix")==0 &&
                STRINGHELPER_BeginsWithSkipSpaceNoCase(" \tHeLLo","hello")==1 &&
                STRINGHELPER_BeginsWithSkipSpaceNoCase("hello","hellish")==0);

            Check("Whitespace helper accepts blank text only",
                STRINGHELPER_IsEntireStringWhitespace(" \t\n")==1 &&
                STRINGHELPER_IsEntireStringWhitespace(" x ")==0);

            Check("StringHelper transformations preserve expected text",
                STRINGHELPER_MakeLowercase("AbC")=="abc" &&
                STRINGHELPER_MakeUppercase("AbC")=="ABC" &&
                STRINGHELPER_FormatLevelName("a/b^c{d}")=="a b c d" &&
                STRINGHELPER_StringCompare("alpha","beta")<0 &&
                STRINGHELPER_StringCompare("same","same")==0);
        });
};
