        },
        {
          "name": "String SetExtension replaces and appends extension",
          "functions": ["String.SetExtension"]
        },
        {
          "name": "String GetPath omits trailing slash by default",
          "functions": ["String.GetPath"]
        },
        {
          "name": "String GetPath can preserve trailing slash",
          "functions": ["String.GetPath"]
        },
        {
          "name": "String GetPath returns empty when no directory exists",
          "functions": ["String.GetPath"]
        }
