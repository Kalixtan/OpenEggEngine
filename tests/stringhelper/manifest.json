          "functions": ["String.Int", "String.Float", "String.String"]
        },
        {
          "name": "String slicing clamps indexes and lengths",
          "functions": ["String.Left", "String.Right", "String.RightAt", "String.Mid", "String.Length", "String.IsEmpty"]
        },
        {
          "name": "String slicing handles zero and past-end ranges",
