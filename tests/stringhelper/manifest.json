{
  "harness": "harness",
  "sections": [
    {
      "name": "Formatting helpers",
      "script": "probe.gm",
      "cases": [
        {
          "name": "MakeTimeString uses the retail format and clamps time",
          "functions": ["STRINGHELPER_MakeTimeString"]
        },
        {
          "name": "MakeTimeTable returns retail table and string types",
          "functions": ["STRINGHELPER_MakeTimeTable"]
        },
        {
          "name": "MakeTimeTable formats minute second and hundredth slots",
          "functions": ["STRINGHELPER_MakeTimeTable"]
        },
        {
          "name": "MakeTimeTable handles zero boundaries clamp and sign",
          "functions": ["STRINGHELPER_MakeTimeTable"]
        },
        {
          "name": "IsNumeric accepts only nonempty decimal digit strings",
          "functions": ["STRINGHELPER_IsNumeric"]
        },
        {
          "name": "Backspace removes one byte and handles empty strings",
          "functions": ["STRINGHELPER_Backspace"]
        },
        {
          "name": "SortAscending sorts string keys or values",
          "functions": ["STRINGHELPER_SortAscending"]
        },
        {
          "name": "SortAscending reads selector only for exactly two integer arguments",
          "functions": ["STRINGHELPER_SortAscending"]
        },
        {
          "name": "CopyAndSetChar uses zero-based byte indexes",
          "functions": ["STRINGHELPER_CopyAndSetChar"]
        },
        {
          "name": "GetChar and GetSubString use raw integer argument slots",
          "functions": ["STRINGHELPER_GetChar", "STRINGHELPER_GetSubString"]
        },
        {
          "name": "IsAlpha requires a one-byte string",
          "functions": ["STRINGHELPER_IsAlpha"]
        },
        {
          "name": "Character predicates use retail byte arguments",
          "functions": [
            "STRINGHELPER_IsBackspace",
            "STRINGHELPER_IsLowercase",
            "STRINGHELPER_IsUppercase",
            "STRINGHELPER_IsAlphanumeric",
            "STRINGHELPER_IsWhitespace"
          ]
        }
      ]
    }
  ]
}
