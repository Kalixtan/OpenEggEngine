global SeqProbe=function(name,value) {
    GameMonkeyScript.loadScript("OEP__"+name+"__"+value+".gm");
};
local s=SEQUENCER();
local a0=SEQUENCERACTION(); local a1=SEQUENCERACTION();
local a2=SEQUENCERACTION(); local a3=SEQUENCERACTION();
s.setTrigger(0,a0,0);
s.setTrigger(1,a1,0);
local third=s.setTrigger(2,a2,0);
s.setTrigger(3,a3,0);
s.moveTriggerToFront(third);
local it=s.getAllTriggers();
SeqProbe("edge.moveOrder.four.0",it.get().getStep()); it.goToNext();
SeqProbe("edge.moveOrder.four.1",it.get().getStep()); it.goToNext();
SeqProbe("edge.moveOrder.four.2",it.get().getStep()); it.goToNext();
SeqProbe("edge.moveOrder.four.3",it.get().getStep());
global Main=function(p) {
    return table(Process=p,constructor=function(){},init=function(){return true;},update=function(){});
};
