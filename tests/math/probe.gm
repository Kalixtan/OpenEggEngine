global Probe=function(name,value) {
    GameMonkeyScript.loadScript("OEP__"+name+"__"+value+".gm");
};
global ProbeVector=function(name,value) {
    Probe(name+".x",value.x);
    Probe(name+".y",value.y);
};
global Main=function(p) {
    local a=vector2D(3,4);
    local b=vector2D(-2,1);
    local zero=vector2D(0,0);
    Probe("math.vector.length",a.length());
    Probe("math.vector.lengthSquared",a.lengthSquared());
    Probe("math.vector.zero",zero.isZeroVector());
    ProbeVector("math.vector.normalized",a.getNormalized());
    ProbeVector("math.vector.zeroNormalized",zero.getNormalized());
    ProbeVector("math.vector.rightNormal",a.getRightNormal());
    ProbeVector("math.vector.leftNormal",a.getLeftNormal());
    ProbeVector("math.vector.toPoint",a.getVectorToPoint(vector2D(6,8)));
    ProbeVector("math.vector.toPointNormalized",a.getVectorToPointNormalized(vector2D(6,8)));
    Probe("math.vector.sameDistance",a.distance(vector2D(6,8)));
    Probe("math.vector.equalAtEpsilon",a.isPrettyMuchEqual(vector2D(3.03125,4)));
    Probe("math.vector.outsideEpsilon",a.isPrettyMuchEqual(vector2D(3.03126,4)));
    Probe("math.vector.scalarProjection",a.scalarProjectOnto(vector2D(0,2)));
    ProbeVector("math.vector.vectorProjection",a.vectorProjectOnto(vector2D(0,2)));
    ProbeVector("math.vector.zeroProjection",a.vectorProjectOnto(zero));
    ProbeVector("math.vector.add",a+b);
    ProbeVector("math.vector.subtract",a-b);
    ProbeVector("math.vector.multiply",a*2);
    ProbeVector("math.vector.divide",a/2);
    Probe("math.range.clamp",MATHUTIL_GETINRANGE(12,0,10));
    Probe("math.range.reversed",MATHUTIL_GETINRANGE(4,10,0));
    Probe("math.range.integerFloat",MATHUTIL_GETINRANGEI(4.9,0,10));
    Probe("math.range.zeroWidth",MATHUTIL_GetPercentageInRange(4,4,4));
    Probe("math.triangle.rising",MATHUTIL_GetTrianglePercentage(0.25,0.5));
    Probe("math.triangle.falling",MATHUTIL_GetTrianglePercentage(0.75,0.5));
    Probe("math.triangle.peakAtZero",MATHUTIL_GetTrianglePercentage(0.5,0));
    Probe("math.angle.radQuadrant3",MATHUTIL_GetAngleRad(vector2D(-1,-1)));
    Probe("math.angle.rad360Quadrant3",MATHUTIL_GetAngleRad360(vector2D(-1,-1)));
    Probe("math.angle.betweenOrthogonal",MATHUTIL_GetRadiansBetween(a,vector2D(-4,3)));
    Probe("math.angle.betweenZero",MATHUTIL_GetRadiansBetween(zero,a));
    Probe("math.angle.signedWrap",MATHUTIL_GetSignedAngleDistance(6.1,0.1));
    Probe("math.angle.positiveWrap",MATHUTIL_GetAngleDistancePositive(6.1,0.1));
    Probe("math.angle.negativeWrap",MATHUTIL_GetAngleDistanceNegative(0.1,6.1));
    local hits=table();
    MATHUTIL_FindCircleCircleIntersection(vector2D(0,0),5,vector2D(8,0),5,hits);
    Probe("math.circle.crossFirstExists",?hits.p1);
    Probe("math.circle.crossSecondExists",?hits.p2);
    MATHUTIL_FindCircleCircleIntersection(vector2D(0,0),5,vector2D(10,0),5,hits);
    Probe("math.circle.tangentFirstExists",?hits.p1);
    Probe("math.circle.tangentSecondExists",?hits.p2);
    MATHUTIL_FindCircleCircleIntersection(vector2D(0,0),1,vector2D(4,0),1,hits);
    Probe("math.circle.disjointFirstExists",?hits.p1);
    ProbeVector("math.line.infiniteProjection",MATHUTIL_FindClosestPointOnLine(vector2D(0,0),vector2D(2,0),vector2D(4,3)));
    ProbeVector("math.line.segmentClamp",MATHUTIL_GetClosestPointOnLineSegment(vector2D(0,0),vector2D(2,0),vector2D(4,3)));
    ProbeVector("math.line.zeroDirection",MATHUTIL_FindClosestPointOnLine(vector2D(2,3),zero,vector2D(8,9)));
    Probe("math.line.segmentDistance",MATHUTIL_GetClosestDistanceFromLineSegmentToPoint(vector2D(0,0),vector2D(2,0),vector2D(4,3)));
    Probe("math.time.seconds",MATHUTIL_GetSeconds(1250));
    Probe("math.time.minutes",MATHUTIL_GetMinutes(90000));
    Probe("math.exp.zeroRate",MATHUTIL_CalculateExponentialDecay(0,100));
    Probe("math.exp.negativeRate",MATHUTIL_CalculateExponentialDecay(-0.01,10));
    Probe("math.exp.reversed",MATHUTIL_CalculateExponentialDecayReversed(0.01,10));
    Probe("math.exp.growth",MATHUTIL_CalculateExponentialGrowth(0.01,10));
    return table(Process=p,init=function(){return true;},update=function(){});
};
