global Probe=function(name,value) {
    GameMonkeyScript.loadScript("OEP__"+name+"__"+value+".gm");
};

global slickerPath="Platformer/levels/gamescom_master_8.wav";
Probe("Audio.loadSoundSlicker.ready",Audio.loadSoundSlicker(slickerPath));
global slickerVoice=Audio.spawnSoundSlicker(slickerPath,0,0,1,0);
Probe("Audio.spawnSoundSlicker.positive",slickerVoice>0);
Probe("Audio.getNumDiracDSPsUsed.spawned",Audio.getNumDiracDSPsUsed());
Probe("Audio.getNumDiracDSPChannelsUsed.spawned",Audio.getNumDiracDSPChannelsUsed());
Probe("Audio.getNumDiracDSPsFree.spawned",Audio.getNumDiracDSPsFree());
Probe("Audio.checkDiracPoolIntegrity.spawned",Audio.checkDiracPoolIntegrity());

global Main=function(p) {
    return table(Process=p,frame=0,constructor=function(){},init=function(){return true;},
        update=function() {
            if (this.frame==1) {
                Probe("Audio.playSoundSlicker.sameVoice",
                    Audio.playSoundSlicker(slickerVoice,0,0,1)==slickerVoice);
                Probe("Audio.playSoundSlicker.volume",
                    Audio.getVoiceVolume(slickerVoice));
            }
            if (this.frame==3) {
                Audio.stopVoice(slickerVoice);
                Audio.unloadSound(slickerPath);
            }
            this.frame+=1;
        });
};
