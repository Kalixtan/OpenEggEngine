global Probe=function(name,value) {
    GameMonkeyScript.loadScript("OEP__"+name+"__"+value+".gm");
};

local path="Platformer/sounds/fx/button-high.wav";
local voice=Audio.spawnSoundSlicker(path,0,0,1,0);
Probe("Audio.spawnSoundSlicker.positive",voice>0);
Probe("Audio.getNumDiracDSPsUsed.spawned",Audio.getNumDiracDSPsUsed());
Probe("Audio.getNumDiracDSPChannelsUsed.spawned",Audio.getNumDiracDSPChannelsUsed());
Probe("Audio.getNumDiracDSPsFree.spawned",Audio.getNumDiracDSPsFree());
Probe("Audio.checkDiracPoolIntegrity.spawned",Audio.checkDiracPoolIntegrity());
Probe("Audio.playSoundSlicker.sameVoice",Audio.playSoundSlicker(voice,0,0,1)==voice);
Probe("Audio.playSoundSlicker.volume",Audio.getVoiceVolume(voice));
Audio.stopVoice(voice);

global Main=function(p) {
    return table(Process=p,constructor=function(){},init=function(){return true;},update=function(){});
};
