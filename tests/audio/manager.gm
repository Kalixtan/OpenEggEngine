global Probe=function(name,value) {
    GameMonkeyScript.loadScript("OEP__"+name+"__"+value+".gm");
};

Audio.startRecordingScript();
Probe("Audio.startRecordingScript.active",Audio.isRecordingScript());
Audio.stopRecordingScript();
Probe("Audio.stopRecordingScript.inactive",Audio.isRecordingScript());

Audio.startRecording();
Probe("Audio.startRecording.active",Audio.isRecording());
Audio.stopRecording();
Probe("Audio.stopRecording.inactive",Audio.isRecording());

Audio.startRetriggering();
Probe("Audio.startRetriggering.active",Audio.isRetriggering());
Audio.setRetriggerTime(123);
Probe("Audio.setRetriggerTime.changed",Audio.getRetriggerTime());
Audio.stopRetriggering();
Probe("Audio.stopRetriggering.inactive",Audio.isRetriggering());

Audio.hack_setEnabled(false);
Probe("Audio.hack_setEnabled.disabled",Audio.playSound("OpenEggProbe/no-sound.wav"));
Audio.hack_setEnabled(true);

global Main=function(p) {
    return table(Process=p,constructor=function(){},init=function(){return true;},update=function(){});
};
