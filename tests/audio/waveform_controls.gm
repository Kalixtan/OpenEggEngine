// Short sounds spaced far enough apart to split the recording.
global Main=function(p) {
    return table(
        Process=p,
        frame=0,
        loopVoice=0,
        pausedVoice=0,
        panLeftVoice=0,
        panRightVoice=0,
        gateVoice=0,
        deferredSpeedVoice=0,
        constructor=function(){},
        init=function() {
            Audio.stopAllVoices();
            Audio.setMusicVolume(0);
            return true;
        },
        update=function() {
            local path="Platformer/sounds/fx/button-high.wav";
            if (this.frame==20) {
                local voice=Audio.playSound(path);
                Audio.setVoiceSpeed(voice,0.5);
            }
            if (this.frame==80) {
                local voice=Audio.playSound(path);
                Audio.setVoiceSpeed(voice,2);
            }
            if (this.frame==110) {
                this.deferredSpeedVoice=Audio.playSound(path);
            }
            if (this.frame==111) {
                Audio.setVoiceSpeed(this.deferredSpeedVoice,2);
            }
            if (this.frame==140) {
                this.fadeVoice=Audio.playSound(path);
                Audio.fadeOutVoice(this.fadeVoice,40);
            }
            if (this.frame==200) {
                this.loopVoice=Audio.playSound(path);
                Audio.setVoiceLoopCount(this.loopVoice,1);
            }
            if (this.frame==225) { Audio.stopVoice(this.loopVoice); }
            if (this.frame==260) {
                this.pausedVoice=Audio.playSound(path);
                Audio.setVoicePause(this.pausedVoice,true);
            }
            if (this.frame==265) { Audio.setVoicePause(this.pausedVoice,false); }
            if (this.frame==320) {
                this.panLeftVoice=Audio.playSound(path);
                Audio.setVoicePan(this.panLeftVoice,-1);
            }
            if (this.frame==380) {
                this.panRightVoice=Audio.playSound(path);
                Audio.setVoicePan(this.panRightVoice,1);
            }
            if (this.frame==440) {
                this.gateVoice=Audio.playSound(
                    "Platformer/sounds/singlenote/tone.wav");
                Audio.setVoiceGateTime(this.gateVoice,100);
            }
            if (this.frame==500) {
                GameMonkeyScript.loadScript("OEP__wave_done__1.gm");
            }
            this.frame+=1;
        }
    );
};
