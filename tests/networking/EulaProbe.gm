global ProbeEula = table(accepted=0);
global SAVEDATAHELPER_HasAcceptedEula = function(version) {
    if (version != "2c9722bceb151bdd7331641615dc1c5f732fc50d") {
        GameSystem.trace("EULA acceptance version FAIL");
    }
    return ProbeEula.accepted;
};

global Main = function(p) {
    return table(
        Process=p,
        checked=0,
        errorChecked=0,
        init=function() { return true; },
        constructor=function() { OnlineCoordinator_GoOnline(); },
        update=function() {
            if (this.checked == 0 && OnlineCoordinator_IsWaitingForEulaAcceptance()) {
                if (Watermelon_GetEula() == "One Two\n\n" &&
                    Watermelon_GetEulaVersion() == "2c9722bceb151bdd7331641615dc1c5f732fc50d") {
                    GameSystem.trace("EULA text and digest PASS");
                }
                this.checked = 1;
                ProbeEula.accepted = 1;
            } else if (this.checked == 1 && !OnlineCoordinator_IsWaitingForEulaAcceptance()) {
                this.checked = 2;
                GameSystem.trace("EULA acceptance PASS");
            } else if (this.checked == 2) {
                local friends = Watermelon_Get_Friends();
                if (friends != null && friends[0] != null && friends[1] != null &&
                    friends[0].identity == "friend-1" && friends[0].displayName == "First" &&
                    friends[1].identity == "friend-2" && friends[1].displayName == "Second") {
                    this.checked = 3;
                    GameSystem.trace("friends snapshot PASS");
                }
            } else if (this.checked == 3) {
                local featured = WatermelonGlobals_GetFeaturedSearches();
                local news = WatermelonGlobals_GetNews();
                if (featured.test == "featured" && news.test == "news") {
                    this.checked = 4;
                    GameSystem.trace("community data PASS");
                }
            } else if (this.checked == 4) {
                local featured = WatermelonGlobals_GetFeaturedSearches();
                local news = WatermelonGlobals_GetNews();
                if (featured.localized != "" && news.localized != "" &&
                    featured.test == "featured" && news.test == "news") {
                    this.checked = 5;
                    GameSystem.trace("localized community data PASS");
                }
            } else if (this.checked == 5 && OnlineCoordinator_IsOnline() && Watermelon_IsOnline()) {
                this.checked = 6;
                GameSystem.trace("coordinator online PASS");
                if (OpenEgg_NetworkTranslation("probe-key") == "probe-value" &&
                    OpenEgg_NetworkTranslation("replacement") == "new" &&
                    OpenEgg_NetworkTranslation("empty-key") == "") {
                    GameSystem.trace("network translation PASS");
                }
                OnlineCoordinator_GoOffline();
                if (OnlineCoordinator_IsOffline() && !Watermelon_IsOnline()) {
                    GameSystem.trace("coordinator offline PASS");
                }
            }
            if (this.errorChecked == 0 && OnlineCoordinator_GetLastError() == -12) {
                this.errorChecked = 1;
                if (Watermelon_GetEula() == null && Watermelon_GetEulaVersion() == "") {
                    GameSystem.trace("EULA failure PASS");
                } else if (Watermelon_Get_Friends() == null) {
                    GameSystem.trace("friends failure PASS");
                }
            }
        }
    );
};
