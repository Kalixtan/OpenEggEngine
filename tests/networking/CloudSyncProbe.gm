global SAVE_DATA = {
    version=1, onlineID="openegg_probe",
    unlocks={unlockedEntities={localEntity=1}},
    campaign={asides={world={localLevel={completion=3}, shared={completion=1}}}, bsides={}},
    editor={editorTrophyLevels={}}
};
global SAVEDATAHELPER_GetSaveData = function() { return SAVE_DATA; };
global SAVEDATAHELPER_unlockMissingThings = function() {};
global CLOUD_TEST_SAVE_ACTION = null;
global CLOUD_TEST_SAVE_CALLBACK = null;
global GAMEUPDATEDATA = {
    registerAction=function(action) { global CLOUD_TEST_SAVE_ACTION; CLOUD_TEST_SAVE_ACTION = action; return true; },
    isSaveBusy=function() { return false; },
    abortLoad=function() {},
    startSave=function(callback, overwrite) {
        global CLOUD_TEST_SAVE_CALLBACK;
        if (!SAVEDATA_SaveAll()) { GameSystem.trace("retail cloud local save FAIL"); return false; }
        CLOUD_TEST_SAVE_CALLBACK = callback;
        return true;
    }
};

global Main = function(p) {
    return table(Process=p,
        constructor=function() {
            GameMonkeyScript.loadScript("Platformer/SaveDataHelper.gm");
            global SAVEDATAHELPER_GetSaveData = function() { return SAVE_DATA; };
            global SAVEDATAHELPER_unlockMissingThings = function() {};
            GameMonkeyScript.loadScript("Platformer/CloudSaveHelper.gm");
            if (?CLOUD_TEST_CASE && CLOUD_TEST_CASE == "mismatched-id") { SAVE_DATA.onlineID = "different-user"; }
            this.sync = CLOUDSAVEHELPER_GetSynchObj();
            if (?CLOUD_TEST_CASE && CLOUD_TEST_CASE == "initial") {
                SAVE_DATA.onlineID = null;
                global REQUIRED_QUOTA_TO_EDIT = 0;
                OnlineCoordinator_GoOnline();
            } else { this.sync.synch(); }
        },
        init=function() { return true; },
        update=function() {
            global CLOUD_TEST_SAVE_CALLBACK;
            global CLOUD_TEST_SAVE_ACTION;
            if (?CLOUD_TEST_CASE && CLOUD_TEST_CASE == "initial" && !?this.started && Watermelon_IsOnline()) {
                this.started = 1;
                this.sync.synch();
            }
            if (?CLOUD_TEST_SAVE_CALLBACK) {
                local callback = CLOUD_TEST_SAVE_CALLBACK;
                CLOUD_TEST_SAVE_CALLBACK = null;
                callback.execute(true);
            }
            if (?CLOUD_TEST_SAVE_ACTION) {
                local action = CLOUD_TEST_SAVE_ACTION;
                CLOUD_TEST_SAVE_ACTION = null;
                action.update();
            }
            this.sync.update();
            if (this.lastState != this.sync.state) {
                GameSystem.trace("retail cloud sync state", this.sync.state);
                this.lastState = this.sync.state;
            }
            if (this.sync.hasError()) {
                if (?CLOUD_TEST_CASE && CLOUD_TEST_CASE == "mismatched-id" &&
                    this.sync.hasError() == SYNCERROR_GET_CALL_FAILED_MISMATCHED_ID) {
                    GameSystem.trace("retail cloud mismatch PASS");
                } else if (?CLOUD_TEST_CASE && CLOUD_TEST_CASE == "server-error" &&
                           this.sync.hasError() == SYNCERROR_GET_CALL_FAILED_RESPONSE) {
                    GameSystem.trace("retail cloud server error PASS");
                } else { GameSystem.trace("retail cloud sync FAIL", this.sync.hasError()); }
                GameSystem.quit();
            } else if (this.sync.isDone()) {
                local world = SAVE_DATA.campaign.asides.world;
                if (?CLOUD_TEST_CASE && CLOUD_TEST_CASE == "initial" && SAVE_DATA.onlineID == "openegg_probe" &&
                    world.localLevel.completion == 3 && world.shared.completion == 1 && !?world.remoteLevel) {
                    GameSystem.trace("retail cloud initial sync PASS");
                } else if (world.localLevel.completion == 3 && world.remoteLevel.completion == 2 &&
                    world.shared.completion == 4 && SAVE_DATA.unlocks.unlockedEntities.localEntity == 1 &&
                    SAVE_DATA.unlocks.unlockedEntities.remoteEntity == 1) {
                    GameSystem.trace("retail cloud sync PASS");
                } else { GameSystem.trace("retail cloud sync merge FAIL"); }
                GameSystem.quit();
            }
        });
};
