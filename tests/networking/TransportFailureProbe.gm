global TransportReply = function(data, result, error) {
    if (data == "partial" && result == null && error == 200) {
        GameSystem.trace("transport partial status PASS");
    } else if (data == "disconnect" && result == null && error == 1) {
        GameSystem.trace("transport no status PASS");
    } else if (data == "success" && result != null && error == 0) {
        GameSystem.trace("transport success PASS");
    } else if (data == "stalled" && result == null && error == 404) {
        GameSystem.trace("transport stalled error PASS");
        Watermelon_Index_Page(TransportReply, "after stall", 407, "type=level&case=after-stall");
    } else if (data == "after stall" && result != null && error == 0) {
        GameSystem.trace("transport after stall PASS");
    } else if (data == "redirect" && result != null && result.count == 7 && error == 0) {
        GameSystem.trace("transport identity redirect PASS");
    } else if (data == "cross redirect" && result == null && error == 302) {
        GameSystem.trace("transport cross redirect blocked PASS");
    } else { GameSystem.trace("transport callback FAIL"); }
};

global TransportLevelReply = function(step, result, error) {
    if (step == 1 && result == null && error == 1) {
        Watermelon_GetLevelData(TransportLevelReply, 2, 404, "transport", "v1");
    } else if (step == 2 && result != null && result.bpm == 130 && error == 0) {
        GameSystem.trace("transport failure not cached PASS");
    } else { GameSystem.trace("transport level FAIL"); }
};

global TransportHttpErrorReply = function(step, result, error) {
    if (step == 1 && result == null && error == 1) {
        Watermelon_GetLevelData(TransportHttpErrorReply, 2, 406, "transport-error", "v1");
    } else if (step == 2 && result == null && error == 1) {
        GameSystem.trace("transport HTTP error cached PASS");
    } else { GameSystem.trace("transport HTTP error FAIL"); }
};

global Main = function(p) {
    return table(Process=p, started=0,
        constructor=function() { OnlineCoordinator_GoOnline(); },
        init=function() { return true; },
        update=function() {
            if (!this.started && Watermelon_IsOnline()) {
                this.started = 1;
                Watermelon_Index_Page(TransportReply, "partial", 401, "type=level&case=partial");
                Watermelon_Index_Page(TransportReply, "disconnect", 402, "type=level&case=disconnect");
                Watermelon_Index_Page(TransportReply, "success", 403, "type=level&case=success");
                Watermelon_Index_Page(TransportReply, "stalled", 406, "type=level&case=stall");
                Watermelon_Index_Page(TransportReply, "redirect", 408, "type=level&case=redirect");
                Watermelon_Index_Page(TransportReply, "cross redirect", 409, "type=level&case=cross-redirect");
                Watermelon_GetLevelData(TransportLevelReply, 1, 404, "transport", "v1");
                Watermelon_GetLevelData(TransportHttpErrorReply, 1, 405, "transport-error", "v1");
            }
        });
};
