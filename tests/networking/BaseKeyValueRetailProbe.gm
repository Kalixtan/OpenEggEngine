global Probe = function(name, value) {
    GameMonkeyScript.loadScript("OEP__" + name + "__" + value + ".gm");
};

global Main = function(p) {
    return table(Process=p,
        init=function() { return true; },
        constructor=function() {
            local ascii = "";
            local i = 0;
            while (i < 198) { ascii += "a"; i += 1; }
            Probe("basekey.before", "call");
            local parsed = Watermelon_BaseKeyValue(ascii + "é:value", {});
            Probe("basekey.utf8overflow.key", STRINGHELPER_GetLength(parsed.key));
        },
        update=function() {});
};
