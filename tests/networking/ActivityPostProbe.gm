global Main = function(p) {
    return table(Process=p,
        constructor=function() {
            Network_ActivityStreamPost("legacy message", "legacy url");
            Network_ActivityStreamPost(2, "message", "format");
            Network_ActivityStreamPost(2, "message", "format", "url");
            Network_ActivityStreamPost(2, "message", "format", "url", "small");
            Network_ActivityStreamPost(2, "message", "format", "url", "small", "large");
            Network_ActivityStreamPost(2, "message", "format", "url", "small", "large", 9);
            GameSystem.trace("activity post wrapper PASS");
            if (!Network_WebBrowserIsAvailable() && !Network_WebBrowserIsRunning() &&
                Network_WebBrowserLaunch("https://example.test/") == -4 &&
                Network_WebBrowserLaunch(7, "ignored") == -4 && Network_WebBrowserFinish() == -4) {
                GameSystem.trace("browser wrapper PASS");
            } else { GameSystem.trace("browser wrapper FAIL"); }
            local details = {keep=42, name="old", description="old", data="old"};
            local returned = Network_NearGetExternalGiftDetails("fixture", details, "ignored");
            if (returned == details && details.keep == 42 && details.name == "" &&
                details.description == "" && details.data == "") {
                GameSystem.trace("near gift table PASS");
            } else { GameSystem.trace("near gift table FAIL"); }
            if (Network_StoreLaunch() == 0) {
                GameSystem.trace("store launch result PASS");
            } else { GameSystem.trace("store launch result FAIL"); }
            if (Network_StoreIsAvailable() == 1) {
                GameSystem.trace("store availability PASS");
            } else { GameSystem.trace("store availability FAIL"); }
            if (Network_StoreGetIsDownloadFinished() == 1) {
                GameSystem.trace("store download status PASS");
            } else { GameSystem.trace("store download status FAIL"); }
        },
        init=function() { return true; },
        update=function() {});
};
