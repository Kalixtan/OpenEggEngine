global TypedIndexReply = function(data, response, error) {
    if (data == "typed" && response.count == 0 && response.items.size == 0 && error == 0) {
        GameSystem.trace("typed index response PASS");
    } else {
        GameSystem.trace("typed index response FAIL");
    }
};

global WildcardIndexReply = function(data, response, error) {
    if (data == "wildcard" && response.count == 0 && response.items.size == 0 && error == 0) {
        GameSystem.trace("wildcard index response PASS");
    } else {
        GameSystem.trace("wildcard index response FAIL");
    }
};

global ForbiddenIndexReply = function(data, response, error) {
    if (data == "forbidden" && response == null && error == 403) {
        GameSystem.trace("index authorization response PASS");
    } else {
        GameSystem.trace("index authorization response FAIL");
    }
};

global AlbumsDeniedReply = function(data, response, error) {
    if (data == "albums" && response == null && error == 403) {
        GameSystem.trace("album list route PASS");
    } else {
        GameSystem.trace("album list route FAIL");
    }
};

global AlbumDeniedReply = function(data, response, error) {
    if (data == "album" && response == null && error == 403) {
        GameSystem.trace("album contents route PASS");
    } else {
        GameSystem.trace("album contents route FAIL");
    }
};

global FollowingDeniedReply = function(data, response, error) {
    if (data == "following" && response == null && error == 403) {
        GameSystem.trace("following page route PASS");
    } else {
        GameSystem.trace("following page route FAIL");
    }
};

global FollowersDeniedReply = function(data, response, error) {
    if (data == "followers" && response == null && error == 403) {
        GameSystem.trace("followers page route PASS");
    } else {
        GameSystem.trace("followers page route FAIL");
    }
};

global Main = function(p) {
    return table(
        Process=p,
        init=function() { return true; },
        constructor=function() {
            local typed = Watermelon_Index_Page(TypedIndexReply, "typed", 1, "type=level&search=tagged3");
            local wildcard = Watermelon_Index_Page(WildcardIndexReply, "wildcard", 2, "search=tagged3");
            local forbidden = Watermelon_Index_Page(ForbiddenIndexReply, "forbidden", 3, "type=level&search=all");
            local albums = Watermelon_Albums_Page(AlbumsDeniedReply, "albums", 4, "from=0&count=1");
            local album = Watermelon_Album_Page(AlbumDeniedReply, "album", 5, "test-id", "from=0&count=1");
            local following = Watermelon_Following_Page(FollowingDeniedReply, "following", 6, "test-user", "from=0&count=1");
            local followers = Watermelon_Followers_Page(FollowersDeniedReply, "followers", 7, "test-user", "from=0&count=1");
            if (typed == 1 && wildcard == 1 && forbidden == 1 && albums == 1 && album == 1 && following == 1 && followers == 1) {
                GameSystem.trace("Watermelon index requests QUEUED");
            } else {
                GameSystem.trace("Watermelon index requests NOT_QUEUED");
            }
        },
        update=function() {}
    );
};
