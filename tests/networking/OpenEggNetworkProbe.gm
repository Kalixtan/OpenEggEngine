global TypedIndexReply = function(data, response, error) {
    if (data == "typed" && response.count == 0 && response.items.size == 0 && error == 0) {
        GameSystem.trace("typed index response PASS");
    } else {
        GameSystem.trace("typed index response FAIL");
    }
};

global WildcardIndexReply = function(data, response, error) {
    if (data == "wildcard" && response.count == 0 && response.items.size == 0 && error == 0) {
        GameSystem.trace("wildcard index response PASS");
    } else {
        GameSystem.trace("wildcard index response FAIL");
    }
};

global ForbiddenIndexReply = function(data, response, error) {
    if (data == "forbidden" && response == null && error == 403) {
        GameSystem.trace("index authorization response PASS");
    } else {
        GameSystem.trace("index authorization response FAIL");
    }
};

global AlbumsDeniedReply = function(data, response, error) {
    if (data == "albums" && response == null && error == 403) {
        GameSystem.trace("album list route PASS");
    } else {
        GameSystem.trace("album list route FAIL");
    }
};

global AlbumDeniedReply = function(data, response, error) {
    if (data == "album" && response == null && error == 403) {
        GameSystem.trace("album contents route PASS");
    } else {
        GameSystem.trace("album contents route FAIL");
    }
};

global FollowingDeniedReply = function(data, response, error) {
    if (data == "following" && response == null && error == 403) {
        GameSystem.trace("following page route PASS");
    } else {
        GameSystem.trace("following page route FAIL");
    }
};

global FollowingActionReply = function(data, response, error) {
    if (data == "following_get" && response == null && error == 403) {
        GameSystem.trace("following get route PASS");
    } else if (data == "following_put" && response == null && error == 403) {
        GameSystem.trace("following put route PASS");
    } else if (data == "following_delete" && response == null && error == 403) {
        GameSystem.trace("following delete route PASS");
    } else {
        GameSystem.trace("following action route FAIL");
    }
};

global QueuedPageReply = function(data, response, error) {
    if (data == "queued_page" && response == null && error == 403) {
        GameSystem.trace("queued page route PASS");
    } else {
        GameSystem.trace("queued page route FAIL");
    }
};

global QueuedActionReply = function(data, response, error) {
    if (data == "queued_get" && response == null && error == 403) {
        GameSystem.trace("queued get route PASS");
    } else if (data == "queued_put" && response == null && error == 403) {
        GameSystem.trace("queued put route PASS");
    } else if (data == "queued_delete" && response == null && error == 403) {
        GameSystem.trace("queued delete route PASS");
    } else {
        GameSystem.trace("queued action route FAIL");
    }
};

global FollowersDeniedReply = function(data, response, error) {
    if (data == "followers" && response == null && error == 403) {
        GameSystem.trace("followers page route PASS");
    } else {
        GameSystem.trace("followers page route FAIL");
    }
};

global ActivityDeniedReply = function(data, response, error) {
    if (data == "activity" && response == null && error == 403) {
        GameSystem.trace("activity page route PASS");
    } else {
        GameSystem.trace("activity page route FAIL");
    }
};

global FeaturedMissingUserReply = function(data, response, error) {
    if (data == "featured" && response == null && error == 404) {
        GameSystem.trace("featured unknown-user response PASS");
    } else {
        GameSystem.trace("featured unknown-user response FAIL");
    }
};

global InvalidTicketReply = function(data, response, status) {
    if (data == "ticket" && status == 400) {
        GameSystem.trace("ticket POST route PASS");
    } else {
        GameSystem.trace("ticket POST route FAIL");
    }
};

global Main = function(p) {
    return table(
        Process=p,
        init=function() { return true; },
        constructor=function() {
            local typed = Watermelon_Index_Page(TypedIndexReply, "typed", 1, "type=level&search=tagged3");
            local wildcard = Watermelon_Index_Page(WildcardIndexReply, "wildcard", 2, "search=tagged3");
            local forbidden = Watermelon_Index_Page(ForbiddenIndexReply, "forbidden", 3, "type=level&search=all");
            local albums = Watermelon_Albums_Page(AlbumsDeniedReply, "albums", 4, "from=0&count=1");
            local album = Watermelon_Album_Page(AlbumDeniedReply, "album", 5, "test-id", "from=0&count=1");
            local following = Watermelon_Following_Page(FollowingDeniedReply, "following", 6, "test-user", "from=0&count=1");
            local followers = Watermelon_Followers_Page(FollowersDeniedReply, "followers", 7, "test-user", "from=0&count=1");
            local activity = Watermelon_ActivityStream_Page(ActivityDeniedReply, "activity", 8, "test-user", "news", "from=0&count=1");
            local featured = Watermelon_FeaturedLevel_Get(FeaturedMissingUserReply, "featured", 9, "test-user");
            local followGet = Watermelon_Following_Get(FollowingActionReply, "following_get", 10, "test-target");
            local followPut = Watermelon_Following_Put(FollowingActionReply, "following_put", 11, "test-target");
            local followDelete = Watermelon_Following_Delete(FollowingActionReply, "following_delete", 12, "test-target");
            local selfFollow = Watermelon_Following_Put(FollowingActionReply, "self", 13, "test-user");
            local queuedPage = Watermelon_Queued_Page(QueuedPageReply, "queued_page", 14, "from=0&count=1");
            local queuedGet = Watermelon_Queued_Get(QueuedActionReply, "queued_get", 15, "test-level");
            local queuedPut = Watermelon_Queued_Put(QueuedActionReply, "queued_put", 16, "test-level");
            local queuedDelete = Watermelon_Queued_Delete(QueuedActionReply, "queued_delete", 17, "test-level");
            local post = OpenEgg_NetworkPost("/otg/identity/login/token/psn.post", "not-a-ticket", "application/octet-stream", InvalidTicketReply, "ticket");
            if (typed == 1 && wildcard == 1 && forbidden == 1 && albums == 1 && album == 1 && following == 1 && followers == 1 && activity == 1 && featured == 1 && followGet == 1 && followPut == 1 && followDelete == 1 && selfFollow == 0 && queuedPage == 1 && queuedGet == 1 && queuedPut == 1 && queuedDelete == 1 && post != 0) {
                GameSystem.trace("Watermelon index requests QUEUED");
            } else {
                GameSystem.trace("Watermelon index requests NOT_QUEUED");
            }
            if (selfFollow == 0) {
                GameSystem.trace("self follow short circuit PASS");
            }
        },
        update=function() {}
    );
};
