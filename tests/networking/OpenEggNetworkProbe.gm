global InvalidTicketReply = function(data, response, status) {
    if (data == "ticket" && status == 400) {
        GameSystem.trace("ticket POST route PASS");
    } else if (data == "empty_ticket" && status == 400) {
        GameSystem.trace("empty POST route PASS");
    } else {
        GameSystem.trace("ticket POST route FAIL");
    }
};

global PurgedReply = function(data, response, error) {
    if (data == "purged" && response == null && error == 1) {
        GameSystem.trace("purged request callback PASS");
    } else {
        GameSystem.trace("purged request callback FAIL");
    }
};

global MetadataReply = function(data, response, error) {
    if (data == "all" && response == null && error == 403) {
        GameSystem.trace("metadata all response PASS");
    } else if (data == "get" && response == null && error == 404) {
        GameSystem.trace("metadata get response PASS");
    } else if (data == "put" && response == null && error == 404) {
        GameSystem.trace("metadata put response PASS");
    } else if (data == "empty_put" && response == null && error == 404) {
        GameSystem.trace("empty metadata put response PASS");
    } else {
        GameSystem.trace("metadata response FAIL");
    }
};

