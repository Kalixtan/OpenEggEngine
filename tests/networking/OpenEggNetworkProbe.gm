global Main = function(p) {
    return table(
        Process=p,
        init=function() { return true; },
        constructor=function() {
            if (OnlineCoordinator_IsDisabled() == 1 && OnlineCoordinator_IsOffline() == 0 && OnlineCoordinator_IsSendQueueFull() == 1) {
                GameSystem.trace("offline send queue state PASS");
            }
            local boundaryKey = Watermelon_BaseKeyValue("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaé:value", {});
            if (boundaryKey.key == "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" && boundaryKey.value == "value") {
                GameSystem.trace("base key multibyte boundary PASS");
            }
            local packedNegative = Watermelon_PackScore(0, -1);
            local unpackedNegative = Watermelon_UnpackScore(packedNegative, {});
            if (packedNegative == "18446744073709551615" && unpackedNegative.tokens == 0 && unpackedNegative.time == -1 && Watermelon_PackScore(32767, 0) == "4294967296") {
                GameSystem.trace("score edge values PASS");
            }
            local levelParts = Watermelon_ParseLevelObjectString("/~level:abc/~version:123", {});
            local singleColon = Watermelon_ParseLevelObjectString("~level:abc", {});
            local noColon = Watermelon_ParseLevelObjectString("abc", {});
            if (levelParts.levelId == "abc" && levelParts.uploadId == "123" && singleColon.levelId == "level:abc" && singleColon.uploadId == "abc" && noColon.levelId == "" && noColon.uploadId == "") {
                GameSystem.trace("level object split PASS");
            }
            local keyParts = Watermelon_BaseKeyValue("~identity:abc/~level:xyz", {});
            local noValue = Watermelon_BaseKeyValue("root:key/leaf", {});
            if (keyParts.base == "~identity:abc" && keyParts.key == "~level" && keyParts.value == "xyz" && noValue.base == "root:key" && noValue.key == "leaf" && noValue.value == "") {
                GameSystem.trace("base key split PASS");
            }
            local parsed = Watermelon_QueryString2GameMonkey("flag&x=1&&x=2&", {});
            if (parsed["flag&x=1&&x=2&"] == 1 && parsed["&x=2&"] == 1 && parsed.x == "2") {
                GameSystem.trace("query flag parsing PASS");
            }
            if (Watermelon_GameMonkey2QueryString({gain=1.25}) == "gain=1.250000") {
                GameSystem.trace("query float format PASS");
            }
            if (Watermelon_GetEula() == null && Watermelon_GetEulaVersion() == "") {
                GameSystem.trace("unloaded EULA values PASS");
            }
            if (Watermelon_GetUserIdentityId() == "test-user") {
                GameSystem.trace("configured identity PASS");
            }
            local typed = Watermelon_Index_Page(TypedIndexReply, "typed", 1, "type=level&search=tagged3");
            local wildcard = Watermelon_Index_Page(WildcardIndexReply, "wildcard", 2, "search=tagged3");
            local forbidden = Watermelon_Index_Page(ForbiddenIndexReply, "forbidden", 3, "type=level&search=all");
            if (typed == 0 && wildcard == 0 && forbidden == 0) { GameSystem.trace("index offline gate PASS"); }
            local albums = Watermelon_Albums_Page(AlbumsDeniedReply, "albums", 4, "from=0&count=1");
            local album = Watermelon_Album_Page(AlbumDeniedReply, "album", 5, "test-id", "from=0&count=1");
            if (albums == 0 && album == 0) { GameSystem.trace("album offline gate PASS"); }
            local following = Watermelon_Following_Page(FollowingDeniedReply, "following", 6, "test-user", "from=0&count=1");
            local followingAll = Watermelon_Following_All(FollowingAllReply, "following_all", 38);
            local followers = Watermelon_Followers_Page(FollowersDeniedReply, "followers", 7, "test-user", "from=0&count=1");
            local hearts = Watermelon_LevelHearts_Page(HeartsPageReply, "hearts_page", 19, "test-user", "from=0&count=1");
            local heartGet = Watermelon_LevelHearts_Get(HeartsActionReply, "heart_get", 39, "test-level");
            local heartPut = Watermelon_LevelHearts_Post(HeartsActionReply, "heart_put", 40, "test-level");
            local heartDelete = Watermelon_LevelHearts_Delete(HeartsActionReply, "heart_delete", 41, "test-level");
            local activity = Watermelon_ActivityStream_Page(ActivityDeniedReply, "activity", 8, "test-user", "news", "from=0&count=1");
            local activityPost = Watermelon_ActivityStream_Post(ActivityPostReply, "activity_post", 36, "~identity:test-user", "test");
            if (activity == 0 && activityPost == 0) { GameSystem.trace("activity offline gate PASS"); }
            local featured = Watermelon_FeaturedLevel_Get(FeaturedOfflineReply, "featured", 9, "test-user");
            local featuredPost = Watermelon_FeaturedLevel_Post(FeaturedOfflineReply, "featured_post", 37, "test-level");
            if (featured == 0 && featuredPost == 0) {
                GameSystem.trace("featured offline gate PASS");
            }
            local ratingGet = Watermelon_Rating_Get(RatingReply, "rating_get", 31, "~level:test-level");
            local record = Watermelon_Record_Post(RecordReply, "record", 42, "test-level", {score="4294967296", completed=1, playTime=1.25});
            if (record == 0) { GameSystem.trace("record offline gate PASS"); }
            local favAll = Watermelon_Favourite_All(FavouriteReply, "favourite_all", 33, "~level:test-level");
            local favPut = Watermelon_Favourite_Put(FavouriteReply, "favourite_put", 34, "~level:test-level", "/~identity:test-user");
            local favDelete = Watermelon_Favourite_Delete(FavouriteReply, "favourite_delete", 35, "~level:test-level", "/~identity:test-user");
            local ratingPut = Watermelon_Rating_Put(RatingReply, "rating_put", 32, "~level:test-level", 1);
            if (favAll == 0 && favPut == 0 && favDelete == 0 && ratingGet == 0 && ratingPut == 0) {
                GameSystem.trace("rating/favourite offline gate PASS");
            }
            local leaderboard = Watermelon_Leaderboard_Page(LeaderboardPageReply, "leaderboard", 24, "~level:test-level", "from=0&count=1");
            local boardGet = Watermelon_Leaderboard_Get(LeaderboardReadReply, "get", 29, "~level:test-level");
            local boardAll = Watermelon_Leaderboard_All(LeaderboardReadReply, "all", 30, "~level:test-level");
            local near = Watermelon_Leaderboard_Near(LeaderboardNearReply, "near", 25, "~level:test-level", "/~identity:test-user", "count=0");
            local scoreInt = Watermelon_Leaderboard_Post(LeaderboardPostReply, "post_int", 26, "global/~campaign:test-level", 42);
            local scoreString = Watermelon_Leaderboard_Post(LeaderboardPostReply, "post_string", 27, "global/~campaign:test-level", "4294967296");
            local scoreInvalid = Watermelon_Leaderboard_Post(null, null, 28, "global/~campaign:test-level", 1.5);
            if (leaderboard == 0 && boardGet == 0 && boardAll == 0 && near == 0 && scoreInt == 0 && scoreString == 0 && scoreInvalid == 0) {
                GameSystem.trace("leaderboard offline gate PASS");
            }
            local metaAll = Watermelon_Metadata_All(MetadataReply, "all", 20, "~identity:test-user");
            local metaGet = Watermelon_Metadata_Get(MetadataReply, "get", 21, "~level:test-level", "featured");
            local metaPut = Watermelon_Metadata_Put(MetadataReply, "put", 22, "~level:test-level", "featured", "value");
            local metaEmpty = Watermelon_Metadata_Put(MetadataReply, "empty_put", 23, "~level:test-level", "featured", "");
            if (metaAll == 0 && metaGet == 0 && metaPut == 0 && metaEmpty == 0) {
                GameSystem.trace("metadata offline gate PASS");
            }
            local followGet = Watermelon_Following_Get(FollowingActionReply, "following_get", 10, "test-target");
            local followPut = Watermelon_Following_Put(FollowingActionReply, "following_put", 11, "test-target");
            local followDelete = Watermelon_Following_Delete(FollowingActionReply, "following_delete", 12, "test-target");
            local selfFollow = Watermelon_Following_Put(FollowingActionReply, "self", 13, "test-user");
            if (following == 0 && followingAll == 0 && followers == 0 && hearts == 0 && heartGet == 0 && heartPut == 0 && heartDelete == 0 && followGet == 0 && followPut == 0 && followDelete == 0 && selfFollow == 0) {
                GameSystem.trace("following/hearts offline gate PASS");
            }
            local queuedPage = Watermelon_Queued_Page(QueuedPageReply, "queued_page", 14, "from=0&count=1");
            local queuedGet = Watermelon_Queued_Get(QueuedActionReply, "queued_get", 15, "test-level");
            local queuedPut = Watermelon_Queued_Put(QueuedActionReply, "queued_put", 16, "/~level:test-level");
            local queuedDelete = Watermelon_Queued_Delete(QueuedActionReply, "queued_delete", 17, "/~level:test-level");
            local noCallback = Watermelon_Queued_Put(null, null, 18, "/~level:test-level");
            if (queuedPage == 0 && queuedGet == 0 && queuedPut == 0 && queuedDelete == 0 && noCallback == 0) { GameSystem.trace("queue offline gate PASS"); }
            local post = OpenEgg_NetworkPost("/otg/identity/login/token/psn.post", "not-a-ticket", "application/octet-stream", InvalidTicketReply, "ticket");
            local emptyPost = OpenEgg_NetworkPost("/otg/identity/login/token/psn.post", "", "application/octet-stream", InvalidTicketReply, "empty_ticket");
            if (emptyPost == 0) {
                GameSystem.trace("empty POST NOT_QUEUED");
            }
            if (typed == 0 && wildcard == 0 && forbidden == 0 && albums == 0 && album == 0 && following == 0 && followers == 0 && activity == 0 && featured == 0 && followGet == 0 && followPut == 0 && followDelete == 0 && selfFollow == 0 && queuedPage == 0 && queuedGet == 0 && queuedPut == 0 && queuedDelete == 0 && post != 0) {
                GameSystem.trace("Watermelon request setup PASS");
            } else {
                GameSystem.trace("Watermelon index requests NOT_QUEUED");
            }
            if (selfFollow == 0) {
                GameSystem.trace("self follow short circuit PASS");
            }
        },
        update=function() {}
    );
};
