global CloudReadAfterDelete = function(data, response, error) {
    if (data == "deleted" && error == 404 && response == null) {
        GameSystem.trace("cloud save deleted PASS");
    } else { GameSystem.trace("cloud save deleted FAIL"); }
};

global CloudDeleted = function(data, response, error) {
    if (data == "delete" && error == 0 && Watermelon_GetCloudSave(CloudReadAfterDelete, "deleted")) {
        GameSystem.trace("cloud save delete PASS");
    } else { GameSystem.trace("cloud save delete FAIL"); }
};

global CloudReadAfterPost = function(data, response, error) {
    if (data == "readback" && error == 0 && response != null && response.progress == 7) {
        GameSystem.trace("cloud save readback PASS");
        if (!Watermelon_PostCloudSave(CloudDeleted, "delete", "{\"onlineID\":\"probe\"}")) {
            GameSystem.trace("cloud save delete setup FAIL");
        }
    } else {
        GameSystem.trace("cloud save readback FAIL");
    }
};

global CloudPosted = function(data, response, error) {
    if (data == "post" && error == 0) {
        GameSystem.trace("cloud save post PASS");
        Watermelon_GetCloudSave(CloudReadAfterPost, "readback");
    } else {
        GameSystem.trace("cloud save post FAIL");
    }
};

global CloudFirstRead = function(data, response, error) {
    if (data == "initial" && error == 404 && response == null) {
        GameSystem.trace("cloud save missing PASS");
        local padding = "";
        local i = 0;
        while (i < 3000) { padding += "x"; i += 1; }
        local save = "{\"onlineID\":\"probe\",\"progress\":7,\"note\":\"----BouNdaRy\",\"padding\":\"" + padding + "\"}";
        if (Watermelon_PostCloudSave(CloudPosted, "post", save) == 1) {
            GameSystem.trace("cloud save queued PASS");
        }
    } else {
        GameSystem.trace("cloud save missing FAIL");
    }
};

global Main = function(p) {
    return table(
        Process=p,
        init=function() { return true; },
        constructor=function() {
            local save = {campaign={asides={track={completion=3, localOnly=5}}},
                          large=16777216, integer=3, decimal=3.25, positive=1, negative=-1};
            local original = save.campaign;
            local remote = {campaign={asides={track={completion=4, remoteOnly=9}}},
                            large=16777217, integer=3.9, decimal=4, positive="x", negative="y"};
            MergeTablesIntoFirstTakingMax(save, remote);
            if (save.campaign == original && save.campaign.asides.track.completion == 4 &&
                save.campaign.asides.track.localOnly == 5 && save.campaign.asides.track.remoteOnly == 9 &&
                save.large == 16777217 && save.integer == 3 && save.decimal == 4 &&
                save.positive == 1 && save.negative == "y") {
                GameSystem.trace("cloud nested merge PASS");
            } else { GameSystem.trace("cloud nested merge FAIL"); }
            local all = "----BouNdaRy --fOsBKwDjKn --krj6RoYg8n --BqiXa1etbG --vghjJJFy5S --HUoWHHxpJN --IkzsNBtjJy --zzzzzzzzzz";
            if (Watermelon_PostCloudSave(CloudPosted, "blocked", all) == 0) {
                GameSystem.trace("cloud boundary exhaustion PASS");
            }
            Watermelon_GetCloudSave(CloudFirstRead, "initial");
        },
        update=function() {}
    );
};
