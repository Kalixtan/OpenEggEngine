global SAVEDATAHELPER_HasAcceptedEula = function(version) { return 1; };

global AccountReply = function(data, result, error) {
    if (error == 0 && result != null) {
        GameSystem.trace("account request PASS");
        OnlineCoordinator_GoOffline();
        OnlineCoordinator_GoOnline();
        data.stage = 2;
    } else { GameSystem.trace("account request FAIL"); }
};

global Main = function(p) {
    return table(Process=p, stage=0,
        constructor=function() { OnlineCoordinator_GoOnline(); },
        init=function() { return true; },
        update=function() {
            if (this.stage == 0 && Watermelon_IsOnline()) {
                this.stage = 1;
                if (OnlineCoordinator_GetOnlineID() == "openegg_probe") { GameSystem.trace("account name PASS"); }
                Watermelon_Index_Page(AccountReply, this, 1, "type=level&search=all");
            } else if (this.stage == 2 && Watermelon_IsOnline()) {
                this.stage = 3;
                GameSystem.trace("account reconnect PASS");
            } else if (this.stage == 3 && OnlineCoordinator_IsOnline()) {
                this.stage = 4;
                GameSystem.trace("account coordinator PASS");
            } else if (this.stage == 0 && OnlineCoordinator_GetLastError() == -12) {
                this.stage = 5;
                if (!Watermelon_IsOnline()) { GameSystem.trace("account rejection PASS"); }
            }
        });
};
