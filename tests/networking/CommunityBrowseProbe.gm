global SW = 1.0;
global OSID_NGP = 3;
global OSID_VITATV = 4;
global SAVEDATAHELPER_HasAcceptedEula = function(version) { return 1; };

global CommunityBrowseReply = function(data, result, error) {
    if (error == 0 && result != null) {
        local proc = GameSystem.getProcess("Platformer_MainMenu5PS3_CommunityScreen");
        if (data.tab.index == proc.DAILY_BUTTON_INDEX) {
            callback_dailyLevelRequest(data, result, error);
        } else {
            callback_firstRequest(data, result, error);
        }
        if (?data.numPanels && data.panels != null) {
            GameSystem.trace("community tab request PASS ", data.tab.index, " panels ", data.numPanels);
            local i;
            for (i = 0; i < data.numPanels; i += 1) {
                local panel = data.panels[i];
                if (panel.type == "level" && panel.levelName == "Probe level" &&
                    ?panel.levelID && panel.authorName == "level_probe_author") {
                    GameSystem.trace("community fixture level PASS ", data.tab.index);
                }
                if (panel.type == "album" && panel.displayName == "Probe album" && ?panel.albumID) {
                    GameSystem.trace("community fixture album PASS ", data.tab.index);
                }
            }
        } else { GameSystem.trace("community tab result FAIL"); }
        data.probeFinished = 1;
    } else {
        GameSystem.trace("community tab request FAIL", error);
    }
};

global CommunityLevelReply = function(data, result, error) {
    if (error == 0 && result != null && result.bpm == 120) {
        GameSystem.trace("community level download PASS");
    } else { GameSystem.trace("community level download FAIL", error); }
    data.levelFinished = 1;
};

global CommunityAlbumRecordReply = function(data, result, error) {
    if (error == 0) {
        GameSystem.trace("community album completion record PASS");
        data.albumRecordFinished = 1;
    } else { GameSystem.trace("community album completion record FAIL", error); }
};

global CommunityQueueCleared = function(data, result, error) {
    if (error == 404 && result == null) { GameSystem.trace("community queue cleared PASS"); }
    else { GameSystem.trace("community queue cleared FAIL", error); }
    data.queueFinished = 1;
};

global CommunityQueueDeleted = function(data, result, error) {
    if (error == 0) {
        GameSystem.trace("community queue delete PASS");
        if (!Watermelon_Queued_Get(CommunityQueueCleared, data, 46, data.queueLevelId)) {
            GameSystem.trace("community queue cleared setup FAIL");
            data.queueFinished = 1;
        }
    } else {
        GameSystem.trace("community queue delete FAIL", error);
        data.queueFinished = 1;
    }
};

global CommunityQueueRead = function(data, result, error) {
    if (error == 0 && result != null) {
        GameSystem.trace("community queue read PASS");
        if (!Watermelon_Queued_Delete(CommunityQueueDeleted, data, 45, data.queueLevelKey)) {
            GameSystem.trace("community queue delete setup FAIL");
            data.queueFinished = 1;
        }
    } else {
        GameSystem.trace("community queue read FAIL", error);
        data.queueFinished = 1;
    }
};

global CommunityQueueAdded = function(data, result, error) {
    if (error == 0) {
        GameSystem.trace("community queue put PASS");
        if (!Watermelon_Queued_Get(CommunityQueueRead, data, 44, data.queueLevelId)) {
            GameSystem.trace("community queue read setup FAIL");
            data.queueFinished = 1;
        }
    } else {
        GameSystem.trace("community queue put FAIL", error);
        data.queueFinished = 1;
    }
};

global CommunityHeartReply = function(data, result, error) {
    if (data.heartStage == 0 && error == 404) {
        GameSystem.trace("community heart missing PASS");
        data.heartStage = 1;
        if (!Watermelon_LevelHearts_Post(CommunityHeartReply, data, 51, data.queueLevelId)) {
            GameSystem.trace("community heart post setup FAIL");
        }
    } else if (data.heartStage == 1 && error == 0) {
        GameSystem.trace("community heart post PASS");
        Network_ActivityStreamPost(2, {user="fixture"}, "fixture activity", "level", "small", "large");
        GameSystem.trace("community activity wrapper PASS");
        data.heartStage = 2;
        if (!Watermelon_LevelHearts_Get(CommunityHeartReply, data, 52, data.queueLevelId)) {
            GameSystem.trace("community heart read setup FAIL");
        }
    } else if (data.heartStage == 2 && error == 0 && result != null) {
        GameSystem.trace("community heart read PASS");
        data.heartStage = 3;
        if (!Watermelon_LevelHearts_Delete(CommunityHeartReply, data, 53, data.queueLevelId)) {
            GameSystem.trace("community heart delete setup FAIL");
        }
    } else if (data.heartStage == 3 && error == 0) {
        GameSystem.trace("community heart delete PASS");
        data.heartStage = 4;
        if (!Watermelon_LevelHearts_Get(CommunityHeartReply, data, 54, data.queueLevelId)) {
            GameSystem.trace("community heart cleared setup FAIL");
        }
    } else if (data.heartStage == 4 && error == 404) {
        GameSystem.trace("community heart cleared PASS");
        data.heartFinished = 1;
    } else {
        GameSystem.trace("community heart request FAIL", data.heartStage, error);
        data.heartFinished = 1;
    }
};

global Main = function(p) {
    return table(Process=p, stage=0, nextTab=0,
        constructor=function() {
            GameMonkeyScript.loadScript("ArrayHelper.gm");
            if (?COMMUNITY_DRAW && COMMUNITY_DRAW) { ColourManager.load("Platformer/colours.dat"); }
            GameMonkeyScript.loadScript("State.gm");
            GameMonkeyScript.loadScript("Platformer/KeyToStringMap.gm");
            GameMonkeyScript.loadScript("VideoHelper.gm");
            GameMonkeyScript.loadScript("Platformer/WatermelonHelperNew.gm");
            GameMonkeyScript.loadScript("Platformer/MainMenu5PS3/CommunityScreenNavBar.gm");
            GameMonkeyScript.loadScript("Platformer/MainMenu5PS3/CommunityScreenLevelPanels.gm");
            GameMonkeyScript.loadScript("Platformer/MainMenu5PS3/CommunityScreenSidePanel.gm");
            GameMonkeyScript.loadScript("Platformer/MainMenu5PS3/CommunityScreenMore.gm");
            GameMonkeyScript.loadScript("Platformer/MainMenu5PS3/CommunityScreenNetworkBusy.gm");
            if (?COMMUNITY_INPUT && COMMUNITY_INPUT) {
                GameMonkeyScript.loadScript("Platformer/MainMenu5/MainMenuPS3Input.gm");
            }
            OnlineCoordinator_GoOnline();
        },
        init=function() { return true; },
        onKeyPress=function(key) {
            if (!(?COMMUNITY_HARNESS_INPUT && COMMUNITY_HARNESS_INPUT) || this.stage != 10 || !OnlineCoordinator_IsOnline()) { return; }
            if (key == KEYBOARD_RIGHT && this.inputCount < 2) {
                this.screen.handleOnKeyPress(key);
                this.inputCount += 1;
            } else if (key == JOYSTICK0_ACCEPT && this.inputCount == 2) {
                if (this.screen.selectedButton == this.screen.hitsButton) {
                    GameSystem.trace("community input selection PASS");
                    this.screen.handleOnKeyPress(key);
                    GameSystem.trace("community harness input PASS");
                    this.stage = 11;
                } else { GameSystem.trace("community input selection FAIL"); }
            }
        },
        finishScreen=function() {
            if (?COMMUNITY_DRAW && COMMUNITY_DRAW) {
                if (this.screen.probeDraws >= 3) { GameSystem.trace("community draw PASS"); }
                else { GameSystem.trace("community draw FAIL"); }
            }
            if (?COMMUNITY_UPDATE && COMMUNITY_UPDATE) {
                if (this.screen.probeUpdates >= 3) { GameSystem.trace("community update PASS"); }
                else { GameSystem.trace("community update FAIL"); }
            }
            this.screen.terminate();
            this.stage = 5;
        },
        update=function() {
            if (this.stage == 0 && Watermelon_IsOnline()) {
                GameSystem.trace("community browse online");
                this.screen = GameSystem.runProcess("Platformer_MainMenu5PS3_CommunityScreen");
                if (this.screen == null || this.screen.Process == null) {
                    GameSystem.trace("community screen missing FAIL");
                    this.stage = 3;
                    return;
                }
                this.screen.region = 1;
                if (?COMMUNITY_INPUT && COMMUNITY_INPUT) { setupInputPS3UGCScreen(this.screen); }
                if (?COMMUNITY_UPDATE && COMMUNITY_UPDATE) {
                    this.screen.parentProc = {homeYOfs=0, currentRegion=1};
                    this.screen.isCurrentRegion = function() { return this.parentProc.currentRegion == this.region; };
                    this.screen.setOrigin(vector2D(0, 0), 0);
                    this.screen.originalUpdate = this.screen.update;
                    this.screen.probeUpdates = 0;
                    this.screen.update = function(elapsed) {
                        this.originalUpdate(elapsed);
                        this.probeUpdates += 1;
                    };
                } else { this.screen.update = null; }
                if (?COMMUNITY_DRAW && COMMUNITY_DRAW) {
                    this.screen.originalPreDraw = this.screen.preDraw;
                    this.screen.probeDraws = 0;
                    this.screen.preDraw = function() {
                        this.originalPreDraw();
                        this.probeDraws += 1;
                    };
                } else { this.screen.preDraw = null; }
                this.stage = 1;
            } else if (this.stage == 1 && this.screen.isInited()) {
                GameSystem.trace("community browse initialized");
                if (!?this.screen.isPaused || this.screen.tabs == null) {
                    GameSystem.trace("community screen init FAIL");
                    this.stage = 3;
                    return;
                }
                this.indices = {this.screen.HITS_BUTTON_INDEX, this.screen.FRIENDS_BUTTON_INDEX,
                                this.screen.ONLINEALBUMS_BUTTON_INDEX, this.screen.DAILY_BUTTON_INDEX,
                                this.screen.HOME_BUTTON_INDEX};
                if (?COMMUNITY_UPDATE && COMMUNITY_UPDATE) { this.stage = 9; }
                else { this.stage = 2; }
            } else if (this.stage == 9 &&
                       this.screen.tabs[this.screen.DAILY_BUTTON_INDEX].status == this.screen.RESPONSE_RECEIVED &&
                       this.screen.tabs[this.screen.DAILY_BUTTON_INDEX].complete) {
                GameSystem.trace("community automatic tab PASS");
                if (?COMMUNITY_NAVIGATE && COMMUNITY_NAVIGATE) { this.stage = 10; this.inputCount = 0; }
                else { this.stage = 2; }
            } else if (this.stage == 10 && OnlineCoordinator_IsOnline()) {
                if (?COMMUNITY_HARNESS_INPUT && COMMUNITY_HARNESS_INPUT) {
                    // Wait for key events forwarded by the test parent.
                } else if (?COMMUNITY_INPUT && COMMUNITY_INPUT) {
                    this.screen.handleOnKeyPress(KEYBOARD_RIGHT);
                    this.screen.handleOnKeyPress(KEYBOARD_RIGHT);
                    if (this.screen.selectedButton == this.screen.hitsButton) {
                        GameSystem.trace("community input selection PASS");
                        this.screen.handleOnKeyPress(JOYSTICK0_ACCEPT);
                    } else { GameSystem.trace("community input selection FAIL"); }
                } else { this.screen.selectTab(this.screen.HITS_BUTTON_INDEX, null, false); }
                if (!(?COMMUNITY_HARNESS_INPUT && COMMUNITY_HARNESS_INPUT)) { this.stage = 11; }
            } else if (this.stage == 11 && this.screen.currentTab == this.screen.HITS_BUTTON_INDEX &&
                       this.screen.tabs[this.screen.HITS_BUTTON_INDEX].status == this.screen.RESPONSE_RECEIVED &&
                       this.screen.tabs[this.screen.HITS_BUTTON_INDEX].complete) {
                GameSystem.trace("community tab navigation PASS");
                this.stage = 2;
            } else if (this.stage == 2 && this.nextTab < 5) {
                local tab = this.screen.tabs[this.indices[this.nextTab]];
                tab.request(null, null, tab.results, CommunityBrowseReply);
                this.stage = 3;
            } else if (this.stage == 3 && ?this.screen.tabs[this.indices[this.nextTab]].results.probeFinished) {
                this.nextTab += 1;
                this.stage = 2;
            } else if (this.stage == 2 && this.nextTab == 5) {
                if (?COMMUNITY_REQUIRE_ALBUM_DETAILS && COMMUNITY_REQUIRE_ALBUM_DETAILS) {
                    this.stage = 12;
                } else if (?COMMUNITY_REQUIRE_THUMBNAIL && COMMUNITY_REQUIRE_THUMBNAIL) {
                    this.stage = 4;
                } else {
                    this.finishScreen();
                }
            } else if (this.stage == 12) {
                local panel = this.screen.tabs[this.screen.ONLINEALBUMS_BUTTON_INDEX].results.panels[0];
                if (?panel && panel.type == "album" && panel.displayName == "Probe album" &&
                    panel.screenshotStatus == this.screen.RESPONSE_RECEIVED &&
                    ?panel.screenshotTexture && panel.screenshotTexture.isValid() &&
                    ?panel.isCompleteTable.completionProgress &&
                    ?panel.isCompleteTable.completionProgress[0] &&
                    !panel.isCompleteTable.completionProgress[0] && !panel.isCompleteTable.isComplete) {
                    GameSystem.trace("community album details PASS");
                    if (?COMMUNITY_REQUIRE_ALBUM_COMPLETE && COMMUNITY_REQUIRE_ALBUM_COMPLETE) {
                        local level = this.screen.tabs[this.screen.HITS_BUTTON_INDEX].results.panels[0];
                        local parts = {};
                        Watermelon_ParseLevelObjectString(level.levelVersionID, parts);
                        if (Watermelon_Record_Post(CommunityAlbumRecordReply, this, 78, parts.levelId,
                            {score="4294967296", completed=1, tokenCount=1, playTime=10, deaths=0, golded=0})) {
                            this.stage = 13;
                        } else { GameSystem.trace("community album completion setup FAIL"); }
                    } else if (?COMMUNITY_REQUIRE_THUMBNAIL && COMMUNITY_REQUIRE_THUMBNAIL) { this.stage = 4; }
                    else { this.finishScreen(); }
                }
            } else if (this.stage == 13 && ?this.albumRecordFinished) {
                local panel = this.screen.tabs[this.screen.ONLINEALBUMS_BUTTON_INDEX].results.panels[0];
                panel.isCompleteTable.completionProgress = null;
                if (Watermelon_Album_Page(WATERMELONHELPER_callback_AlbumCompletion, panel.isCompleteTable,
                    77, panel.albumID, "count=20&decorate=completed")) { this.stage = 14; }
                else { GameSystem.trace("community album refresh setup FAIL"); }
            } else if (this.stage == 14) {
                local panel = this.screen.tabs[this.screen.ONLINEALBUMS_BUTTON_INDEX].results.panels[0];
                if (?panel.isCompleteTable.completionProgress && panel.isCompleteTable.completionProgress[0] &&
                    panel.isCompleteTable.isComplete) {
                    GameSystem.trace("community album completed PASS");
                    if (?COMMUNITY_REQUIRE_THUMBNAIL && COMMUNITY_REQUIRE_THUMBNAIL) { this.stage = 4; }
                    else { this.finishScreen(); }
                }
            } else if (this.stage == 4) {
                local panels = this.screen.tabs[this.screen.HITS_BUTTON_INDEX].results.panels;
                local panel = panels[0];
                if (?panel && panel.levelName == "Probe level" &&
                    panel.screenshotStatus == this.screen.RESPONSE_RECEIVED &&
                    ?panel.screenshotTexture && panel.screenshotTexture.isValid()) {
                    GameSystem.trace("community thumbnail PASS");
                    if (?COMMUNITY_REQUIRE_LEVEL && COMMUNITY_REQUIRE_LEVEL) {
                        local parts = {};
                        Watermelon_ParseLevelObjectString(panel.levelVersionID, parts);
                        this.queueLevelKey = panel.levelID;
                        this.queueLevelId = parts.levelId;
                        if (Watermelon_GetLevelData(CommunityLevelReply, this, 42, parts.levelId, parts.uploadId, "ignored")) {
                            this.stage = 6;
                        } else {
                            GameSystem.trace("community level queue FAIL");
                            this.stage = 5;
                        }
                    } else {
                        this.finishScreen();
                    }
                }
            } else if (this.stage == 6 && ?this.levelFinished) {
                if (?COMMUNITY_REQUIRE_QUEUE && COMMUNITY_REQUIRE_QUEUE) {
                    if (Watermelon_Queued_Put(CommunityQueueAdded, this, 43, this.queueLevelKey)) {
                        this.stage = 7;
                    } else {
                        GameSystem.trace("community queue put setup FAIL");
                        this.stage = 5;
                    }
                } else {
                    this.finishScreen();
                }
            } else if (this.stage == 7 && ?this.queueFinished) {
                if (?COMMUNITY_REQUIRE_HEART && COMMUNITY_REQUIRE_HEART) {
                    this.heartStage = 0;
                    this.stage = 8;
                    if (!Watermelon_LevelHearts_Get(CommunityHeartReply, this, 50, this.queueLevelId)) {
                        GameSystem.trace("community heart missing setup FAIL");
                    }
                } else {
                    this.finishScreen();
                }
            } else if (this.stage == 8 && ?this.heartFinished) {
                this.finishScreen();
            }
        });
};
