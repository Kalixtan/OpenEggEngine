global SW = 1.0;
global OSID_NGP = 3;
global OSID_VITATV = 4;
global SAVEDATAHELPER_HasAcceptedEula = function(version) { return 1; };

global CommunityBrowseReply = function(data, result, error) {
    if (error == 0 && result != null) {
        local proc = GameSystem.getProcess("Platformer_MainMenu5PS3_CommunityScreen");
        if (data.tab.index == proc.DAILY_BUTTON_INDEX) {
            callback_dailyLevelRequest(data, result, error);
        } else {
            callback_firstRequest(data, result, error);
        }
        if (?data.numPanels && data.panels != null) {
            GameSystem.trace("community tab request PASS ", data.tab.index, " panels ", data.numPanels);
            local i;
            for (i = 0; i < data.numPanels; i += 1) {
                local panel = data.panels[i];
                if (panel.type == "level" && panel.levelName == "Probe level" &&
                    ?panel.levelID && panel.authorName == "level_probe_author") {
                    GameSystem.trace("community fixture level PASS ", data.tab.index);
                }
            }
        } else { GameSystem.trace("community tab result FAIL"); }
        data.probeFinished = 1;
    } else {
        GameSystem.trace("community tab request FAIL", error);
    }
};

global CommunityLevelReply = function(data, result, error) {
    if (error == 0 && result != null && result.bpm == 120) {
        GameSystem.trace("community level download PASS");
    } else { GameSystem.trace("community level download FAIL", error); }
    data.levelFinished = 1;
};

global Main = function(p) {
    return table(Process=p, stage=0, nextTab=0,
        constructor=function() {
            GameMonkeyScript.loadScript("ArrayHelper.gm");
            GameMonkeyScript.loadScript("State.gm");
            GameMonkeyScript.loadScript("Platformer/KeyToStringMap.gm");
            GameMonkeyScript.loadScript("VideoHelper.gm");
            GameMonkeyScript.loadScript("Platformer/WatermelonHelperNew.gm");
            GameMonkeyScript.loadScript("Platformer/MainMenu5PS3/CommunityScreenNavBar.gm");
            GameMonkeyScript.loadScript("Platformer/MainMenu5PS3/CommunityScreenLevelPanels.gm");
            GameMonkeyScript.loadScript("Platformer/MainMenu5PS3/CommunityScreenSidePanel.gm");
            GameMonkeyScript.loadScript("Platformer/MainMenu5PS3/CommunityScreenMore.gm");
            GameMonkeyScript.loadScript("Platformer/MainMenu5PS3/CommunityScreenNetworkBusy.gm");
            OnlineCoordinator_GoOnline();
        },
        init=function() { return true; },
        update=function() {
            if (this.stage == 0 && Watermelon_IsOnline()) {
                GameSystem.trace("community browse online");
                this.screen = GameSystem.runProcess("Platformer_MainMenu5PS3_CommunityScreen");
                if (this.screen == null || this.screen.Process == null) {
                    GameSystem.trace("community screen missing FAIL");
                    this.stage = 3;
                    return;
                }
                this.screen.region = 1;
                this.screen.preDraw = null;
                this.screen.update = null;
                this.stage = 1;
            } else if (this.stage == 1 && this.screen.isInited()) {
                GameSystem.trace("community browse initialized");
                if (!?this.screen.isPaused || this.screen.tabs == null) {
                    GameSystem.trace("community screen init FAIL");
                    this.stage = 3;
                    return;
                }
                this.stage = 2;
                this.indices = {this.screen.HITS_BUTTON_INDEX, this.screen.FRIENDS_BUTTON_INDEX,
                                this.screen.ONLINEALBUMS_BUTTON_INDEX, this.screen.DAILY_BUTTON_INDEX,
                                this.screen.HOME_BUTTON_INDEX};
            } else if (this.stage == 2 && this.nextTab < 5) {
                local tab = this.screen.tabs[this.indices[this.nextTab]];
                tab.request(null, null, tab.results, CommunityBrowseReply);
                this.stage = 3;
            } else if (this.stage == 3 && ?this.screen.tabs[this.indices[this.nextTab]].results.probeFinished) {
                this.nextTab += 1;
                this.stage = 2;
            } else if (this.stage == 2 && this.nextTab == 5) {
                if (?COMMUNITY_REQUIRE_THUMBNAIL && COMMUNITY_REQUIRE_THUMBNAIL) {
                    this.stage = 4;
                } else {
                    this.screen.terminate();
                    this.stage = 5;
                }
            } else if (this.stage == 4) {
                local panels = this.screen.tabs[this.screen.HITS_BUTTON_INDEX].results.panels;
                local panel = panels[0];
                if (?panel && panel.levelName == "Probe level" &&
                    panel.screenshotStatus == this.screen.RESPONSE_RECEIVED &&
                    ?panel.screenshotTexture && panel.screenshotTexture.isValid()) {
                    GameSystem.trace("community thumbnail PASS");
                    if (?COMMUNITY_REQUIRE_LEVEL && COMMUNITY_REQUIRE_LEVEL) {
                        local parts = {};
                        Watermelon_ParseLevelObjectString(panel.levelVersionID, parts);
                        if (Watermelon_GetLevelData(CommunityLevelReply, this, 42, parts.levelId, parts.uploadId)) {
                            this.stage = 6;
                        } else {
                            GameSystem.trace("community level queue FAIL");
                            this.stage = 5;
                        }
                    } else {
                        this.screen.terminate();
                        this.stage = 5;
                    }
                }
            } else if (this.stage == 6 && ?this.levelFinished) {
                this.screen.terminate();
                this.stage = 5;
            }
        });
};
