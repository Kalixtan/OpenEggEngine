global BacklogReply = function(data, result, error) {
    if (error != 0 || result == null) { GameSystem.trace("completion backlog callback FAIL"); }
    data.received += 1;
};

global Main = function(p) {
    return table(Process=p, started=0, ticks=0, received=0,
        constructor=function() { OnlineCoordinator_GoOnline(); },
        init=function() { return true; },
        update=function() {
            if (!this.started && Watermelon_IsOnline()) {
                this.started = 1;
                local i = 0;
                for (i=0; i<100; i+=1) {
                    Watermelon_Index_Page(BacklogReply, this, 301, "type=level&backlog=1");
                }
                GameSystem.trace("completion backlog queued");
            } else if (this.started == 1) {
                this.ticks += 1;
                if (this.ticks == 180) {
                    this.started = 2;
                    GameSystem.trace("completion backlog callbacks " + this.received);
                    if (this.received == 100) { GameSystem.trace("completion backlog PASS"); }
                    else { GameSystem.trace("completion backlog FAIL"); }
                }
            }
        });
};
