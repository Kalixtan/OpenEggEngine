global Probe = function(name, value) {
    GameMonkeyScript.loadScript("OEP__" + name + "__" + value + ".gm");
};

global Main = function(p) {
    return table(Process=p,
        init=function() { return true; },
        constructor=function() {
            Probe("string.length.a", STRINGHELPER_GetLength("a"));
            Probe("string.length.empty", STRINGHELPER_GetLength(""));
            Probe("url.encode.space", Watermelon_UrlEncode(" "));
            Probe("url.encode.space.length",
                STRINGHELPER_GetLength(Watermelon_UrlEncode(" ")));
            Probe("url.encode.unreserved", Watermelon_UrlEncode("AZaz09-_.~"));
            Probe("url.encode.unreserved.length",
                STRINGHELPER_GetLength(Watermelon_UrlEncode("AZaz09-_.~")));
            Probe("url.encode.reserved.a", Watermelon_UrlEncode(" !#$%&'()*+"));
            Probe("url.encode.reserved.b", Watermelon_UrlEncode(",/:;=?@[]"));
            Probe("url.encode.utf8", Watermelon_UrlEncode("é"));
            Probe("url.encode.utf8.length",
                STRINGHELPER_GetLength(Watermelon_UrlEncode("é")));

            local spaces = "";
            local i = 0;
            while (i < 170) { spaces += " "; i += 1; }
            local encoded = Watermelon_UrlEncode(spaces);
            Probe("url.encode.spaces170.inputlen", STRINGHELPER_GetLength(spaces));
            Probe("url.encode.spaces170.length", STRINGHELPER_GetLength(encoded));
            Probe("url.encode.spaces170.char509", STRINGHELPER_GetChar(509, encoded));
            Probe("url.encode.spaces170.char510", STRINGHELPER_GetChar(510, encoded));
            Probe("url.encode.spaces170.char511", STRINGHELPER_GetChar(511, encoded));

            spaces += " ";
            encoded = Watermelon_UrlEncode(spaces);
            Probe("url.encode.spaces171.length", STRINGHELPER_GetLength(encoded));

            local plain = "";
            i = 0;
            while (i < 511) { plain += "a"; i += 1; }
            Probe("url.encode.plain511.length",
                STRINGHELPER_GetLength(Watermelon_UrlEncode(plain)));
            plain += "a";
            Probe("url.encode.plain512.length",
                STRINGHELPER_GetLength(Watermelon_UrlEncode(plain)));
        },
        update=function() {});
};
