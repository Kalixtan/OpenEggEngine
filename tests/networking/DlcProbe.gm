global Main = function(p) {
    return table(Process=p,
        constructor=function() {
            Network_RunDLCCheck();
            local pass = Network_IsDLCCheckComplete() == 1;
            if (__DEBUG_ENABLED__) {
                pass = pass &&
                Network_IsDLCAvailable("1") == 1 &&
                Network_IsDLCAvailable("0x1") == 1 &&
                Network_IsDLCAvailable("01") == 1 &&
                Network_IsDLCAvailable("+1") == 1 &&
                Network_IsDLCAvailable("1tail") == 1 &&
                Network_IsDLCAvailable("0xF") == 1 &&
                Network_IsDLCAvailable("15") == 1 &&
                Network_IsDLCAvailable("0") == 0 &&
                Network_IsDLCAvailable("16") == 0 &&
                Network_IsDLCAvailable("0x10") == 0 &&
                Network_IsDLCAvailable("09") == 0 &&
                Network_IsDLCAvailable("n/a") == 0;
            } else {
                pass = pass && Network_IsDLCAvailable("1") == 0 &&
                    Network_IsDLCAvailable("0x1") == 0;
            }
            if (pass) {
                GameSystem.trace("DLC ID parsing PASS");
            } else {
                GameSystem.trace("DLC ID parsing FAIL");
            }
        },
        init=function() { return true; },
        update=function() {});
};
