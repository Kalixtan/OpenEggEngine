global AuthIndexReply = function(data, response, error) {
    if (data == "authenticated" && error == 0 && (("__LEVEL_ID__" == "" && response.count == 0 && tableCount(response.items) == 0) || ("__LEVEL_ID__" != "" && response.count == 1 && tableCount(response.items) == 1))) {
        GameSystem.trace("authenticated index response PASS");
    } else {
        GameSystem.trace("authenticated index response FAIL");
    }
};

global AuthUserPageReply = function(data, response, error) {
    if (error == 0 && response.count == 0 && tableCount(response.items) == 0) {
        if (data == "following") {
            GameSystem.trace("authenticated following response PASS");
        } else if (data == "followers") {
            GameSystem.trace("authenticated followers response PASS");
        } else if (data == "hearts") {
            GameSystem.trace("authenticated hearts response PASS");
        }
    } else {
        GameSystem.trace("authenticated user page response FAIL");
    }
};

global AuthFollowCleared = function(data, response, error) {
    if (error == 0 && response.count == 0 && tableCount(response.items) == 0) {
        GameSystem.trace("authenticated unfollow readback PASS");
    } else {
        GameSystem.trace("authenticated unfollow readback FAIL");
    }
};

global AuthFollowDeleted = function(data, response, error) {
    if (error == 0) {
        GameSystem.trace("authenticated unfollow PASS");
        Watermelon_Following_Page(AuthFollowCleared, null, 13, Watermelon_GetUserIdentityId(), "from=0&count=1");
    } else {
        GameSystem.trace("authenticated unfollow FAIL");
    }
};

global AuthFollowRead = function(data, response, error) {
    if (error == 0 && response != null) {
        GameSystem.trace("authenticated follow read PASS");
        Watermelon_Following_Delete(AuthFollowDeleted, null, 12, data);
    } else {
        GameSystem.trace("authenticated follow read FAIL");
    }
};

global AuthFollowPut = function(data, response, error) {
    if (error == 0) {
        GameSystem.trace("authenticated follow PASS");
        Watermelon_Following_Get(AuthFollowRead, data, 11, data);
    } else {
        GameSystem.trace("authenticated follow FAIL");
    }
};

global AuthHeartCleared = function(data, response, error) {
    if (error == 0 && response.count == 0 && tableCount(response.items) == 0) {
        GameSystem.trace("authenticated unheart readback PASS");
    } else {
        GameSystem.trace("authenticated unheart readback FAIL");
    }
};

global AuthHeartDeleted = function(data, response, error) {
    if (error == 0) {
        GameSystem.trace("authenticated unheart PASS");
        Watermelon_LevelHearts_Page(AuthHeartCleared, null, 17, Watermelon_GetUserIdentityId(), "from=0&count=1");
    } else {
        GameSystem.trace("authenticated unheart FAIL");
    }
};

global AuthHeartRead = function(data, response, error) {
    if (error == 0 && response != null) {
        GameSystem.trace("authenticated heart read PASS");
        Watermelon_LevelHearts_Delete(AuthHeartDeleted, null, 16, data);
    } else {
        GameSystem.trace("authenticated heart read FAIL");
    }
};

global AuthHeartPut = function(data, response, error) {
    if (error == 0) {
        GameSystem.trace("authenticated heart PASS");
        Watermelon_LevelHearts_Get(AuthHeartRead, data, 15, data);
    } else {
        GameSystem.trace("authenticated heart FAIL");
    }
};

global AuthUnpublishDenied = function(data, response, error) {
    if (error == 403 && response == null) {
        GameSystem.trace("authenticated unpublish denied PASS");
    } else {
        GameSystem.trace("authenticated unpublish denied FAIL");
    }
};

global AuthSnapshotReply = function(data, response, error) {
    if (error == 0 && response != null && response.id != null) {
        local parsed = {};
        Watermelon_ParseLevelObjectString(response.id, parsed);
        if (parsed.levelId == data && parsed.uploadId != null) {
            GameSystem.trace("authenticated snapshot PASS");
            return;
        }
    }
    GameSystem.trace("authenticated snapshot FAIL");
};

global AuthRecordLeaderboard = function(data, response, error) {
    if (error == 0 && tableCount(response.items) > 0 && response.items[0].score == "4294967296") {
        GameSystem.trace("authenticated record readback PASS");
    } else {
        GameSystem.trace("authenticated record readback FAIL");
    }
};

global AuthRecordReply = function(data, response, error) {
    if (error == 0) {
        GameSystem.trace("authenticated record post PASS");
        Watermelon_Leaderboard_Page(AuthRecordLeaderboard, null, 22, "~level:" + data, "from=0&count=1");
    } else {
        GameSystem.trace("authenticated record post FAIL");
    }
};

global AuthVersionsReply = function(data, response, error) {
    if (error == 404 && response == null) {
        GameSystem.trace("authenticated versions response PASS");
    } else {
        GameSystem.trace("authenticated versions response FAIL");
    }
};

global Main = function(p) {
    return table(
        Process=p,
        started=0,
        init=function() { return true; },
        constructor=function() { OnlineCoordinator_GoOnline(); },
        update=function() {
            if (this.started || !Watermelon_IsOnline()) { return; }
            this.started = 1;
            local request = Watermelon_Index_Page(AuthIndexReply, "authenticated", 1, "type=level&search=all&count=1");
            local identity = Watermelon_GetUserIdentityId();
            local following = Watermelon_Following_Page(AuthUserPageReply, "following", 2, identity, "from=0&count=1");
            local followers = Watermelon_Followers_Page(AuthUserPageReply, "followers", 3, identity, "from=0&count=1");
            local hearts = Watermelon_LevelHearts_Page(AuthUserPageReply, "hearts", 4, identity, "from=0&count=1");
            if ("__TARGET_ID__" != "") {
                Watermelon_Following_Put(AuthFollowPut, "__TARGET_ID__", 10, "__TARGET_ID__");
            }
            if ("__LEVEL_ID__" != "") {
                Watermelon_LevelHearts_Post(AuthHeartPut, "__LEVEL_ID__", 14, "__LEVEL_ID__");
                Watermelon_UnpublishLevel(AuthUnpublishDenied, null, 18, "__LEVEL_ID__");
                Watermelon_GetSnapshot(AuthSnapshotReply, "__LEVEL_ID__", 19, "__LEVEL_ID__");
                Watermelon_GetLevelVersions(AuthVersionsReply, null, 20, "__LEVEL_ID__");
                Watermelon_Record_Post(AuthRecordReply, "__LEVEL_ID__", 21, "__LEVEL_ID__", {score="4294967296", completed=1, tokenCount=1, playTime=10, deaths=0, golded=0});
            }
            if (request == 1) {
                GameSystem.trace("authenticated request QUEUED");
            }
            if (following == 1 && followers == 1 && hearts == 1) {
                GameSystem.trace("authenticated user pages QUEUED");
            }
        }
    );
};
