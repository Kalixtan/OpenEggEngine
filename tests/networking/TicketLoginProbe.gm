global TicketLoginReply = function(data, response, error) {
    if (error == 0 && response != null) {
        GameSystem.trace("ticket authenticated request PASS");
        OnlineCoordinator_GoOffline();
        if (OnlineCoordinator_IsOffline() && Watermelon_GetUserIdentityId() == "") {
            if (!Watermelon_IsOnline()) {
                GameSystem.trace("ticket coordinator logout PASS");
            }
        }
    } else if (OnlineCoordinator_GetLastError() == -12) {
        GameSystem.trace("ticket request rejected PASS");
    } else {
        GameSystem.trace("ticket authenticated request FAIL");
    }
};

global Main = function(p) {
    return table(
        Process=p,
        started=0,
        errorReported=0,
        init=function() { return true; },
        constructor=function() {
            if (OnlineCoordinator_GetOnlineID() == "openegg_probe") {
                GameSystem.trace("ticket platform ID PASS");
            } else if (OnlineCoordinator_GetOnlineID() == "") {
                GameSystem.trace("ticket platform ID unavailable PASS");
            }
            if (OnlineCoordinator_IsOffline() && !OnlineCoordinator_IsDisabled() &&
                Watermelon_GetUserIdentityId() == "" && !Watermelon_IsOnline()) {
                GameSystem.trace("ticket coordinator offline PASS");
            }
            OnlineCoordinator_GoOnline();
            if (OnlineCoordinator_IsConnecting() && !OnlineCoordinator_IsOnline()) {
                GameSystem.trace("ticket coordinator connecting PASS");
            }
            if (OnlineCoordinator_HasChatPermissions() && !OnlineCoordinator_IsSendQueueFull()) {
                GameSystem.trace("desktop community permissions PASS");
            } else if (!OnlineCoordinator_HasChatPermissions() && !OnlineCoordinator_IsSendQueueFull()) {
                GameSystem.trace("desktop community restricted PASS");
            }
            OnlineCoordinator_GoOffline();
            if (OnlineCoordinator_IsOffline() && Watermelon_GetUserIdentityId() == "" &&
                !Watermelon_IsOnline()) {
                GameSystem.trace("ticket coordinator cancel PASS");
            }
            OnlineCoordinator_GoOnline();
        },
        update=function() {
            if (this.errorReported == 0 && OnlineCoordinator_GetLastError() == -12) {
                this.errorReported = 1;
                GameSystem.trace("ticket coordinator error PASS");
                if (OnlineCoordinator_IsOffline() && !OnlineCoordinator_IsConnecting()) {
                    GameSystem.trace("ticket coordinator failure returns offline PASS");
                }
            }
            if (this.started == 0 && Watermelon_GetUserIdentityId() != "") {
                this.started = 1;
                if (Watermelon_IsOnline()) {
                    GameSystem.trace("ticket identity PASS");
                } else {
                    GameSystem.trace("ticket identity FAIL");
                    return;
                }
                Watermelon_Index_Page(TicketLoginReply, null, 1, "type=level&search=all&count=1");
            }
        }
    );
};
