global LevelReply = function(data, result, error) {
    if (data == "json" && error == 0 && result != null && result.bpm == 120 && result.screenData[0].screenX == 3 && result.screenData.size == 1 && result.entities.size == 0) {
        GameSystem.trace("level JSON PASS");
    } else if (data == "xml" && error == 0 && result != null && result.bpm == 120 && result.screenData[0].screenX == 3 && result.screenData.size == 1) {
        GameSystem.trace("level XML PASS");
    } else if (data == "invalid" && error == 0 && result == null) {
        GameSystem.trace("level invalid data PASS");
    } else if (data == "missing" && error == 1 && result == null) {
        GameSystem.trace("level missing PASS");
    } else {
        GameSystem.trace("level callback FAIL");
    }
};

global DescriptionReply = function(data, result, error) {
    if (data == "description" && error == 0 && result != null && result.title == "Fixture") {
        GameSystem.trace("description JSON PASS");
    } else if (data == "malformed" && error == 0 && result != null && tableCount(result) == 0) {
        GameSystem.trace("description malformed PASS");
    } else if (data == "partial" && error == 0 && result != null && result.title == "Retained") {
        GameSystem.trace("description partial PASS");
    } else if (data == "missing" && error == 1 && result == null) {
        GameSystem.trace("description missing PASS");
    } else {
        GameSystem.trace("description callback FAIL");
    }
};

global SoundReply = function(data, result, error) {
    if (data == "compressed" && error == 0 && result == null && Audio.isPlayingScript()) {
        GameSystem.trace("sound compressed PASS");
        Watermelon_GetSoundData(SoundReply, "fun", 80, "level-1", "fun", "ignored");
    } else if (data == "fun" && error == 0 && result == null && !Audio.isPlayingScript()) {
        GameSystem.trace("sound fun prefix PASS");
        Audio.startPlayingScript();
        Watermelon_GetSoundData(SoundReply, "invalid", 81, "level-1", "invalid");
    } else if (data == "invalid" && error == 0 && result == null && !Audio.isPlayingScript()) {
        GameSystem.trace("sound invalid PASS");
        Audio.startPlayingScript();
        Watermelon_GetSoundData(SoundReply, "missing", 82, "level-1", "missing");
    } else if (data == "missing" && error == 1 && result == null && Audio.isPlayingScript()) {
        GameSystem.trace("sound missing PASS");
        Audio.stopPlayingScript();
    } else {
        GameSystem.trace("sound callback FAIL");
    }
};

global QueuedRouteReply = function(data, result, error) {
    if (error == 0 && result != null) { GameSystem.trace("queued " + data + " route PASS"); }
    else { GameSystem.trace("queued route callback FAIL"); }
};

global RatingFavouriteReply = function(data, result, error) {
    if (error == 0 && result != null) { GameSystem.trace(data + " response PASS"); }
    else { GameSystem.trace("rating/favourite callback FAIL"); }
};

global MetadataFixtureReply = function(data, result, error) {
    if (error == 0 && result != null && ((data == "get" && result == "{\"ok\":1}") || (data != "get" && result.ok == 1))) { GameSystem.trace("metadata " + data + " PASS"); }
    else { GameSystem.trace("metadata callback FAIL"); }
};

global LeaderboardFixtureReply = function(data, result, error) {
    if (error == 0 && result != null && result.score == "4294967296") { GameSystem.trace("leaderboard " + data + " PASS"); }
    else { GameSystem.trace("leaderboard callback FAIL"); }
};

global AlbumFixtureReply = function(data, result, error) {
    if (error == 0 && result != null && result.ok == 1) { GameSystem.trace("album " + data + " PASS"); }
    else { GameSystem.trace("album callback FAIL"); }
};

global IndexFixtureReply = function(data, result, error) {
    if (data == "malformed" && error == 0 && result != null && result.invalid == null) { GameSystem.trace("index malformed PASS"); }
    else if (data == "partial" && error == 0 && result != null && result.first == 7 && result.nested.done == 2 && result.nested.unfinished == null) { GameSystem.trace("index partial PASS"); }
    else if (data == "array" && error == 0 && result != null && result.values[0] == 1 && result.values[1] == 2 && tableCount(result.values) == 2 && result.values.size == null) { GameSystem.trace("index partial array PASS"); }
    else if (data == "items" && error == 0 && result != null && tableCount(result.items) == 2 && result.items[1].id == "second" && result.items.size == null) { GameSystem.trace("index item count PASS"); }
    else if ((data == "scalar number" || data == "scalar string" || data == "scalar null" || data == "scalar bool") && error == 0 && result != null && tableCount(result) == 0) { GameSystem.trace("index " + data + " PASS"); }
    else if (error == 0 && result != null && tableCount(result.items) == 0 && result.items.size == null && result.count == 0) { GameSystem.trace("index " + data + " PASS"); }
    else { GameSystem.trace("index callback FAIL"); }
};

global ActivityFixtureReply = function(data, result, error) {
    if (error == 0 && result != null && result.ok == 1) { GameSystem.trace("activity " + data + " PASS"); }
    else { GameSystem.trace("activity callback FAIL"); }
};

global SocialFixtureReply = function(data, result, error) {
    if (error == 0 && result != null && result.ok == 1) { GameSystem.trace("social " + data + " PASS"); }
    else { GameSystem.trace("social callback FAIL"); }
};

global RecordFixtureReply = function(data, result, error) {
    if (error == 0 && result != null && result.ok == 1) { GameSystem.trace("record " + data + " PASS"); }
    else { GameSystem.trace("record callback FAIL"); }
};

global LevelLookupFixtureReply = function(data, result, error) {
    if (error == 0 && result != null && result.ok == 1) { GameSystem.trace("level lookup " + data + " PASS"); }
    else { GameSystem.trace("level lookup callback FAIL"); }
};

global Main = function(p) {
    return table(
        Process=p,
        started=0,
        ticks=0,
        init=function() { return true; },
        constructor=function() {
            if (!Watermelon_Rating_Get(null, null, 0, "~level:level-1") &&
                !Watermelon_Rating_Put(null, null, 0, "~level:level-1", 1) &&
                !Watermelon_Favourite_All(null, null, 0, "~level:level-1") &&
                !Watermelon_Favourite_Put(null, null, 0, "~level:level-1", "item") &&
                !Watermelon_Favourite_Delete(null, null, 0, "~level:level-1", "item")) {
                GameSystem.trace("rating/favourite offline gate PASS");
            }
            OnlineCoordinator_GoOnline();
        },
        update=function() {
            if (this.started == 0 && Watermelon_IsOnline()) {
                this.started = 1;
                Watermelon_Rating_Get(RatingFavouriteReply, "rating get", 90, "~level:level-1");
                Watermelon_Rating_Put(RatingFavouriteReply, "rating put", 91, "~level:level-1", 1);
                Watermelon_Favourite_All(RatingFavouriteReply, "favourite all", 92, "~level:level-1");
                Watermelon_Favourite_Put(RatingFavouriteReply, "favourite put", 93, "~level:level-1", "item");
                Watermelon_Favourite_Delete(RatingFavouriteReply, "favourite delete", 94, "~level:level-1", "item");
                Watermelon_Metadata_All(MetadataFixtureReply, "all", 95, "~level:level-1");
                Watermelon_Metadata_Get(MetadataFixtureReply, "get", 96, "~level:level-1", "field");
                Watermelon_Metadata_Put(MetadataFixtureReply, "put", 97, "~level:level-1", "field", "value");
                Watermelon_Metadata_Put(MetadataFixtureReply, "empty", 98, "~level:level-1", "field", "");
                Watermelon_Leaderboard_Get(LeaderboardFixtureReply, "get", 101, "~level:level-1");
                Watermelon_Leaderboard_All(LeaderboardFixtureReply, "all", 102, "~level:level-1");
                Watermelon_Leaderboard_Page(LeaderboardFixtureReply, "page", 103, "~level:level-1", "count=2");
                Watermelon_Leaderboard_Page(LeaderboardFixtureReply, "partial", 135, "~level:level-1", "broken=1");
                Watermelon_Leaderboard_Near(LeaderboardFixtureReply, "near", 104, "~level:level-1", "/~identity:one", "count=2");
                Watermelon_Leaderboard_Post(LeaderboardFixtureReply, "integer", 105, "~level:level-1", 42);
                Watermelon_Leaderboard_Post(LeaderboardFixtureReply, "string", 106, "~level:level-1", "4294967296");
                if (!Watermelon_Leaderboard_Post(null, null, 107, "~level:level-1", 1.5)) { GameSystem.trace("leaderboard invalid score PASS"); }
            } else if (this.started == 1) {
                this.ticks += 1;
                if (this.ticks < 15) { return; }
                this.started = 2;
                this.ticks = 0;
                Watermelon_Albums_Page(AlbumFixtureReply, "list", 108, "from=1&count=2");
                Watermelon_Album_Page(AlbumFixtureReply, "contents", 109, "album-1", "from=1&count=2");
                Watermelon_Album_Page(AlbumFixtureReply, "empty", 110, "");
                Watermelon_Index_Page(IndexFixtureReply, "typed", 111, "type=level&count=1");
                Watermelon_Index_Page(IndexFixtureReply, "wildcard", 112, "count=1");
                Watermelon_Index_Page(IndexFixtureReply, "flag", 142, "typeX");
                Watermelon_Index_Page(IndexFixtureReply, "bare", 143, "type");
                Watermelon_Index_Page(IndexFixtureReply, "duplicate", 144, "type=alpha&type=beta");
                Watermelon_Index_Page(IndexFixtureReply, "empty type", 145, "type=&type=alpha");
                Watermelon_Index_Page(IndexFixtureReply, "malformed", 132, "type=broken");
                Watermelon_Index_Page(IndexFixtureReply, "partial", 133, "type=partial");
                Watermelon_Index_Page(IndexFixtureReply, "array", 134, "type=array");
                Watermelon_Index_Page(IndexFixtureReply, "items", 136, "type=items");
                Watermelon_Index_Page(IndexFixtureReply, "scalar number", 137, "type=number");
                Watermelon_Index_Page(IndexFixtureReply, "scalar string", 138, "type=string");
                Watermelon_Index_Page(IndexFixtureReply, "scalar null", 139, "type=null");
                Watermelon_Index_Page(IndexFixtureReply, "scalar bool", 140, "type=bool");
            } else if (this.started == 2) {
                this.ticks += 1;
                if (this.ticks < 15) { return; }
                this.started = 3;
                Watermelon_ActivityStream_Page(ActivityFixtureReply, "page", 113, "user-1", "news", "count=2");
                Watermelon_ActivityStream_Page(ActivityFixtureReply, "empty", 114, "", "");
                Watermelon_ActivityStream_Post(ActivityFixtureReply, "post", 115, "~identity:user-1", "entry");
                Watermelon_Following_Page(SocialFixtureReply, "following", 116, "", "count=2");
                Watermelon_Followers_Page(SocialFixtureReply, "followers", 117, null, "count=2");
                Watermelon_Following_All(SocialFixtureReply, "all", 118);
                Watermelon_Following_Get(SocialFixtureReply, "get", 119, "target");
                Watermelon_Following_Put(SocialFixtureReply, "put", 120, "target");
                Watermelon_Following_Delete(SocialFixtureReply, "delete", 121, "target");
                Watermelon_LevelHearts_Page(SocialFixtureReply, "hearts", 122, null, "count=2");
                Watermelon_LevelHearts_Get(SocialFixtureReply, "heart get", 123, "level-1");
                Watermelon_LevelHearts_Post(SocialFixtureReply, "heart put", 124, "level-1");
                Watermelon_LevelHearts_Delete(SocialFixtureReply, "heart delete", 125, "level-1");
                if (!Watermelon_Following_Put(null, null, 126, Watermelon_GetUserIdentityId())) { GameSystem.trace("social self follow PASS"); }
                Watermelon_Record_Post(RecordFixtureReply, "values", 127, "level-1", {score="4294967296", completed=1, playTime=1.25});
                Watermelon_Record_Post(RecordFixtureReply, "empty", 128, "level-1", {});
                Watermelon_GetSnapshot(LevelLookupFixtureReply, "snapshot", 129, "level-1");
                Watermelon_GetLevelVersions(LevelLookupFixtureReply, "versions", 130, "level-1");
                Watermelon_UnpublishLevel(LevelLookupFixtureReply, "unpublish", 131, "level-1");
                Watermelon_Queued_Get(QueuedRouteReply, "get", 83, "simple");
                Watermelon_Queued_Put(QueuedRouteReply, "put", 84, "simple");
                Watermelon_Queued_Delete(QueuedRouteReply, "delete", 85, "/~level:simple");
                Watermelon_Queued_Page(QueuedRouteReply, "page", 86, "count=2");
                if (Watermelon_Queued_Put(null, null, 87, "simple")) { GameSystem.trace("queued null callback PASS"); }
                if (Watermelon_GetSoundData(SoundReply, "compressed", 79, "level-1", "compressed")) {
                    GameSystem.trace("sound request queued PASS");
                }
                if (Watermelon_GetLevelDescription(DescriptionReply, "description", 75, "level-1", "good") &&
                    Watermelon_GetLevelDescription(DescriptionReply, "malformed", 76, "level-1", "invalid") &&
                    Watermelon_GetLevelDescription(DescriptionReply, "partial", 141, "level-1", "partial") &&
                    Watermelon_GetLevelDescription(DescriptionReply, "missing", 77, "level-1", "missing")) {
                    GameSystem.trace("description requests queued PASS");
                }
                if (Watermelon_GetLevelData(LevelReply, "json", 71, "level-1", "json", "ignored") &&
                    Watermelon_GetLevelData(LevelReply, "xml", 72, "level-1", "xml") &&
                    Watermelon_GetLevelData(LevelReply, "invalid", 73, "level-1", "invalid") &&
                    Watermelon_GetLevelData(LevelReply, "missing", 74, "level-1", "missing")) {
                    GameSystem.trace("level requests queued PASS");
                }
            }
        }
    );
};
