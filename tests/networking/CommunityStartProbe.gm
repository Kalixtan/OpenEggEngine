global SW = 1.0;
global OSID_NGP = 3;
global OSID_VITATV = 4;
global Main = function(p) {
    return table(Process=p,
        constructor=function() {
            GameMonkeyScript.loadScript("ArrayHelper.gm");
            GameMonkeyScript.loadScript("State.gm");
            GameMonkeyScript.loadScript("Platformer/KeyToStringMap.gm");
            GameMonkeyScript.loadScript("VideoHelper.gm");
            GameMonkeyScript.loadScript("Platformer/MainMenu5PS3/CommunityScreenNavBar.gm");
            GameMonkeyScript.loadScript("Platformer/MainMenu5PS3/CommunityScreenLevelPanels.gm");
            GameMonkeyScript.loadScript("Platformer/MainMenu5PS3/CommunityScreenSidePanel.gm");
            GameMonkeyScript.loadScript("Platformer/MainMenu5PS3/CommunityScreenMore.gm");
            GameMonkeyScript.loadScript("Platformer/MainMenu5PS3/CommunityScreenNetworkBusy.gm");

            local screen = GameSystem.runProcess("Platformer_MainMenu5PS3_CommunityScreen");
            if (screen != null && screen.Process != null) {
                // The menu normally sets the stencil region and supplies fonts.
                screen.region = 1;
                screen.preDraw = null;
                this.screen = screen;
            }
            if (?COMMONCOMMUNITYSTUFF_InitCommonCommunityScreenStuff && screen != null &&
                screen.Process != null && screen.preDrawList != null && screen.widgets != null) {
                GameSystem.trace("community screen constructor PASS");
            } else if (screen != null && screen.Process == null && screen.isInited()) {
                GameSystem.trace("community fallback PASS"); screen.terminate();
            } else { GameSystem.trace("community screen constructor FAIL"); }
        },
        init=function() { return true; },
        update=function() {
            if (?this.screen && this.screen.isInited()) {
                if (this.screen.tabs != null && this.screen.navBar.buttons[0] != null &&
                    this.screen.selectedButton != null && this.screen.homeTab != null && ?this.screen.isPaused) {
                    GameSystem.trace("community screen init PASS");
                } else { GameSystem.trace("community screen init FAIL"); }
                this.screen.terminate(); this.screen = null;
            }
        });
};
