global LocaleProbeState = table(accepted=0);
global SAVEDATAHELPER_HasAcceptedEula = function(version) { return LocaleProbeState.accepted; };

global Main = function(p) {
    return table(Process=p, checked=0,
        constructor=function() {
            if (Network_GetNetworkLanguageCode() == "__EXPECTED__") {
                GameSystem.trace("network locale PASS");
            } else { GameSystem.trace("network locale FAIL"); }
            OnlineCoordinator_GoOnline();
        },
        init=function() { return true; },
        update=function() {
            if (this.checked == 0 && OnlineCoordinator_IsWaitingForEulaAcceptance()) {
                this.checked = 1;
                GameSystem.trace("localized EULA PASS");
                LocaleProbeState.accepted = 1;
            } else if (this.checked == 1 && OnlineCoordinator_IsOnline()) {
                this.checked = 2;
                GameSystem.trace("localized community requests PASS");
            }
        });
};
