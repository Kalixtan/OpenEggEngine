global ServerEulaState = table(accepted=0);
global SAVEDATAHELPER_HasAcceptedEula = function(version) { return ServerEulaState.accepted; };

global Main = function(p) {
    return table(
        Process=p,
        checked=0,
        init=function() { return true; },
        constructor=function() { OnlineCoordinator_GoOnline(); },
        update=function() {
            if (this.checked == 0 && OnlineCoordinator_IsWaitingForEulaAcceptance()) {
                this.checked = 1;
                if (Watermelon_GetEula() != null && Watermelon_GetEulaVersion() != "") {
                    GameSystem.trace("server EULA PASS");
                }
                ServerEulaState.accepted = 1;
            } else if (this.checked == 1 && Watermelon_Get_Friends() != null) {
                this.checked = 2;
                GameSystem.trace("server friends PASS");
            } else if (this.checked == 2 && OnlineCoordinator_IsOnline() && Watermelon_IsOnline()) {
                this.checked = 3;
                GameSystem.trace("server coordinator online PASS");
                if (OpenEgg_Network_IsReplacementServerAuthenticated() &&
                    !OpenEgg_Network_IsPSNSignedIn()) {
                    GameSystem.trace("replacement auth distinct from PSN PASS");
                }
            }
        }
    );
};
