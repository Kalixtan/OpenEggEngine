global UnauthorizedEula = table(accepted=0, checked=0);
global SAVEDATAHELPER_HasAcceptedEula = function(version) {
    return UnauthorizedEula.accepted;
};

global Main = function(p) {
    return table(
        Process = p,
        init = function() { return true; },
        constructor = function() { OnlineCoordinator_GoOnline(); },
        update = function() {
            if (this.checked == 0 && OnlineCoordinator_IsWaitingForEulaAcceptance()) {
                this.checked = 1;
                if (Watermelon_GetEula() == "Registration code: probe-code\n") {
                    GameSystem.trace("server registration message visible PASS");
                } else {
                    GameSystem.trace("server registration message visible FAIL");
                }
                UnauthorizedEula.accepted = 1;
            } else if (this.checked == 1 && OnlineCoordinator_GetLastError() == -12) {
                this.checked = 2;
                if (OnlineCoordinator_IsOffline() &&
                    !OpenEgg_Network_IsReplacementServerAuthenticated()) {
                    GameSystem.trace("unauthorized EULA acceptance stays offline PASS");
                } else {
                    GameSystem.trace("unauthorized EULA acceptance stays offline FAIL");
                }
            }
        }
    );
};
