global Probe=function(name,value) {
    GameMonkeyScript.loadScript("OEP__"+name+"__"+value+".gm");
};
GameMonkeyScript.loadScript("EntityGCProbe.gm");
global EntityGCState=table(stage=0,id=-1);
global ProbeGC=function(name,value) {
    Probe("entityGC."+name,value);
};
global Main=function(p) {
    return table(Process=p,frame=0,constructor=function(){},init=function(){return true;},
        update=function() {
            local state=EntityGCState;
            if (state.stage==0) {
                GameSystem.setIsShouldUpdateEntities(0);
                local entity=EntityManager.createEntity("EntityGCProbe");
                state.id=entity.getObjectID();
                local data=entity.getPhysicsData();
                local body=data.getBody(data.createBody());
                body.setPos(vector2D(7,11));
                EntityManager.flush();
                ProbeGC("scheduled",GameMonkeyScript.clean(1)==null);
                ProbeGC("collectingBeforeTick",GameMonkeyScript.isCollectingGarbage());
                state.stage=1;
            } else if (state.stage==1) {
                ProbeGC("collectingAfterTick",GameMonkeyScript.isCollectingGarbage());
                ProbeGC("activeAfterGC",EntityManager.isEntityIDValid(state.id));
                ProbeGC("lookupAfterGC",
                    EntityManager.getEntity(state.id).getObjectID()==state.id);
                local retained=EntityManager.getEntity(state.id).getPhysicsData().getBody(0);
                ProbeGC("bodyAfterGC",retained.getPos().x);
                state.retainedBody=retained;
                EntityManager.deleteAllEntities();
                EntityManager.flush();
                ProbeGC("deletedBeforeGC",!EntityManager.isEntityIDValid(state.id));
                GameMonkeyScript.clean(1);
                state.stage=2;
            } else if (state.stage==2) {
                ProbeGC("collectingAfterDeleteGC",GameMonkeyScript.isCollectingGarbage());
                ProbeGC("deletedAfterGC",!EntityManager.isEntityIDValid(state.id));
                local detachedSleeping=state.retainedBody.isSleeping();
                ProbeGC("detachedBodySleeping",detachedSleeping);
                state.retainedBody=null;
                GameMonkeyScript.clean(1);
                state.stage=3;
            } else if (state.stage==3) {
                ProbeGC("collectingAfterReleaseGC",GameMonkeyScript.isCollectingGarbage());
                ProbeGC("entityStillDeleted",!EntityManager.isEntityIDValid(state.id));
                state.stage=4;
            }
        });
};
