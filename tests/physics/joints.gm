global Probe=function(name,value) {
    GameMonkeyScript.loadScript("OEP__"+name+"__"+value+".gm");
};
global JointShape=PHYSICSSHAPECOLLECTIONDEF();

global JointBody=function(x,y,mass) {
    local e=EntityManager.createEntity();
    local pd=e.getPhysicsData();
    local b=pd.getBody(pd.createBody());
    b.setPos(vector2D(x,y));
    JointShape.reset();
    JointShape.setMass(mass);
    JointShape.addCircle(1,0,0);
    b.appendShapes(JointShape);
    return table(e=e,pd=pd,b=b);
};
global JointSample=function(name,tick,j,a,b) {
    local key="joint."+name+".t"+tick+".";
    local anchor=j.getAnchorPos();
    local force=j.getReactionForce(60);
    Probe(key+"type",j.getType());
    Probe(key+"body1X",j.getBody1().getPos().x);
    Probe(key+"entity1Same",j.getEntity1().getObjectID()==a.e.getObjectID());
    if (name!="pin") {
        Probe(key+"body2X",j.getBody2().getPos().x);
        Probe(key+"entity2Same",j.getEntity2().getObjectID()==b.e.getObjectID());
    }
    Probe(key+"collidable",j.isBodiesCollidable());
    Probe(key+"anchorX",anchor.x);
    Probe(key+"anchorY",anchor.y);
    Probe(key+"forceX",force.x);
    Probe(key+"forceY",force.y);
    Probe(key+"torque",j.getReactionTorque(60));
    Probe(key+"aX",a.b.getPos().x);
    Probe(key+"bX",b.b.getPos().x);
};
global Main=function(p) {
    return table(Process=p,frame=0,constructor=function(){},init=function(){return true;},
        update=function() {
            if (this.frame<12) {
                if (this.frame==0) {
                    this.da=JointBody(0,100,1);
                    this.db=JointBody(5,100,1);
                    this.distance=Physics.createJoint(PHYSICSJOINTTYPE_DISTANCE);
                    this.distance.setupDistanceJoint(this.da.b,this.db.b,
                        this.da.b.getPos(),this.db.b.getPos());
                    Probe("jointType.setLinearSpring.result",
                        this.distance.setLinearSpring(2,0.5));
                    Probe("jointType.setIsNeedsHighAccuracy.result",
                        this.distance.setIsNeedsHighAccuracy(1));
                    this.db.b.setVel(vector2D(0.5,0));

                    this.ra=JointBody(30,200,0);
                    this.rb=JointBody(35,200,1);
                    this.revolute=Physics.createJoint(PHYSICSJOINTTYPE_REVOLUTE);
                    this.revolute.setupJoint(this.ra.b,this.rb.b,vector2D(30,200));
                    Probe("jointType.setRevoluteAngularConstraint.result",
                        this.revolute.setRevoluteAngularConstraint(1,-0.2,0.2));
                    this.rb.b.setVel(vector2D(0,0.3));

                    this.pa=JointBody(60,300,1);
                    this.pin=Physics.createJoint(PHYSICSJOINTTYPE_PIN);
                    this.pin.setupPinJoint(this.pa.b,vector2D(60,300));
                    Probe("jointType.setPinAngularConstraint.result",
                        this.pin.setPinAngularConstraint(1,-0.25,0.25));
                    this.pa.b.setVel(vector2D(0.2,0));

                    this.sa=JointBody(90,400,0);
                    this.sb=JointBody(95,400,1);
                    this.prismatic=Physics.createJoint(PHYSICSJOINTTYPE_PRISMATIC);
                    this.prismatic.setPrismaticWorldAxis(vector2D(1,0));
                    this.prismatic.setupJoint(this.sa.b,this.sb.b,vector2D(90,400));
                    this.sb.b.setVel(vector2D(0.1,0));

                    this.la=JointBody(120,500,1);
                    this.lb=JointBody(125,500,1);
                    this.relative=Physics.createJoint(PHYSICSJOINTTYPE_RELATIVE);
                    this.relative.setupRelativeJoint(this.la.b,this.lb.b);
                    Probe("jointType.setAngularSpring.result",
                        this.relative.setAngularSpring(3,0.75));
                    this.relative.setRelativeVel(vector2D(0.1,0));
                }
                JointSample("distance",this.frame,this.distance,this.da,this.db);
                JointSample("revolute",this.frame,this.revolute,this.ra,this.rb);
                JointSample("pin",this.frame,this.pin,this.pa,this.pa);
                JointSample("prismatic",this.frame,this.prismatic,this.sa,this.sb);
                JointSample("relative",this.frame,this.relative,this.la,this.lb);
                this.frame+=1;
            } else if (this.frame==12) {
                local distanceID=this.distance.getObjectID();
                local revoluteID=this.revolute.getObjectID();
                Probe("joint.registry.idDistinct",revoluteID!=distanceID);
                Probe("joint.registry.lookup",Physics.getJoint(distanceID)!=null);
                Probe("joint.registry.unknown",Physics.getJoint(-1)==null);
                local attached=this.ra.e.getPhysicsData().getJointsOnMe();
                Probe("jointIter.attachedSize",attached.size());
                Probe("jointIter.attachedValid",attached.isValid());
                Probe("jointIter.attachedType",attached.get().getType());
                attached.goToNext();
                Probe("jointIter.afterEndValid",attached.isValid());
                this.extraJointBody=JointBody(40,200,1);
                this.extraJoint=Physics.createJoint(PHYSICSJOINTTYPE_REVOLUTE);
                this.extraJoint.setupJoint(this.ra.b,this.extraJointBody.b,vector2D(30,200));
                local attachedMany=this.ra.e.getPhysicsData().getJointsOnMe();
                Probe("jointIter.multipleSize",attachedMany.size());
                Probe("jointIter.firstIsOriginal",attachedMany.get().getObjectID()==revoluteID);
                attachedMany.goToNext();
                Probe("jointIter.secondIsExtra",
                    attachedMany.isValid() && attachedMany.get().getObjectID()==this.extraJoint.getObjectID());
                attachedMany.goToNext();
                Probe("jointIter.afterTwoValid",attachedMany.isValid());
                this.revolute.setRTMotorSpeed(0.625);
                Probe("joint.control.rtSpeed",this.revolute.getRTMotorSpeed());
                this.revolute.setRevoluteMotor(1);
                Probe("joint.control.motorReset",this.revolute.getRTMotorSpeed());
                this.revolute.setRevoluteMotor(1,0.375,2);
                Probe("joint.control.motorSet",this.revolute.getRTMotorSpeed());
                this.revolute.setMotor(1,0.25,3);
                Probe("joint.control.genericMotor",this.revolute.getRTMotorSpeed());
                this.revolute.setIsBodiesCollidable(1);
                Probe("joint.control.collidableOn",this.revolute.isBodiesCollidable());
                Probe("joint.control.motorAfterRebuild",this.revolute.getRTMotorSpeed());
                this.revolute.setIsBodiesCollidable(0);
                Probe("joint.control.collidableOff",this.revolute.isBodiesCollidable());

                this.configA=JointBody(1000,600,0);
                this.configB=JointBody(1005,600,1);
                this.configRevolute=Physics.createJoint(PHYSICSJOINTTYPE_REVOLUTE);
                this.configRevolute.setRevoluteMotor(1,0.375,2);
                this.configRevolute.setupJoint(this.configA.b,this.configB.b,vector2D(1000,600));
                Probe("joint.config.revoluteMotor",this.configRevolute.getRTMotorSpeed());
                this.configGeneric=Physics.createJoint(PHYSICSJOINTTYPE_REVOLUTE);
                this.configGeneric.setMotor(1,0.25,3);
                this.configGeneric.setupJoint(this.configA.b,this.configB.b,vector2D(1005,600));
                Probe("joint.config.genericMotor",this.configGeneric.getRTMotorSpeed());
                this.configReset=Physics.createJoint(PHYSICSJOINTTYPE_REVOLUTE);
                this.configReset.setMotor(1,0.5,4);
                this.configReset.setRevoluteMotor(1);
                this.configReset.setupJoint(this.configA.b,this.configB.b,vector2D(1010,600));
                Probe("joint.config.resetMotor",this.configReset.getRTMotorSpeed());

                this.configPinBody=JointBody(1040,600,1);
                this.configPin=Physics.createJoint(PHYSICSJOINTTYPE_PIN);
                this.configPin.setPinMotor(1,0.2,2);
                this.configPin.setupPinJoint(this.configPinBody.b,vector2D(1040,600));
                Probe("joint.config.pinMotor",this.configPin.getRTMotorSpeed());
                this.configPin.setRTMotorSpeed(0.55);
                this.configPin.setRTMaxMotorTorque(1.25);
                Probe("joint.control.pinRtSpeed",this.configPin.getRTMotorSpeed());

                this.configPrismaticA=JointBody(1070,600,0);
                this.configPrismaticB=JointBody(1075,600,1);
                this.configPrismatic=Physics.createJoint(PHYSICSJOINTTYPE_PRISMATIC);
                this.configPrismatic.setPrismaticWorldAxis(vector2D(1,0));
                this.configPrismatic.setPrismaticTranslation(0.35,2);
                this.configPrismatic.setupJoint(this.configPrismaticA.b,this.configPrismaticB.b,
                    vector2D(1070,600));
                Probe("joint.config.prismaticTranslation",this.configPrismatic.getRTMotorSpeed());
                this.configPrismatic.setRTMotorSpeed(0.65);
                Probe("joint.control.prismaticRtSpeed",this.configPrismatic.getRTMotorSpeed());

                this.configPrismaticGeneric=Physics.createJoint(PHYSICSJOINTTYPE_PRISMATIC);
                this.configPrismaticGeneric.setPrismaticWorldAxis(vector2D(1,0));
                this.configPrismaticGeneric.setMotor(1,0.45,3);
                this.configPrismaticGeneric.setupJoint(this.configPrismaticA.b,this.configPrismaticB.b,
                    vector2D(1075,600));
                Probe("joint.config.prismaticMotor",this.configPrismaticGeneric.getRTMotorSpeed());
                Physics.deleteJoint(this.distance);
                Probe("joint.registry.deleted",Physics.getJoint(distanceID)==null);
                Physics.deleteAllJoints();
                Probe("joint.registry.cleared",Physics.getJoint(revoluteID)==null);
                this.frame+=1;
            }
        });
};
