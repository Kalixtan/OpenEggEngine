global Probe=function(name,value) {
    GameMonkeyScript.loadScript("OEP__"+name+"__"+value+".gm");
};

Probe("Global.MATH_ABS.negative",MATH_ABS(-3.5));
Probe("Global.MATH_ACOS.clampedHigh",MATH_ACOS(2));
Probe("Global.MATH_ASIN.clampedLow",MATH_ASIN(-2));
Probe("Global.MATH_ATAN2.quadrantTwo",MATH_ATAN2(1,-1));
Probe("Global.MATH_COS.zero",MATH_COS(0));
Probe("Global.MATH_COS.twoArg",MATH_COS(0,2));
Probe("Global.MATH_COS_POW.negativeCurve",MATH_COS_POW(0.7,-1));
Probe("Global.MATH_EXP.zero",MATH_EXP(0));
Probe("Global.MATH_FLOOR.negative",MATH_FLOOR(-1.2));
Probe("Global.MATH_INT.negative",MATH_INT(-1.8));
Probe("Global.MATH_MAX.mixed",MATH_MAX(-2,3));
Probe("Global.MATH_MAXI.integer",MATH_MAXI(-2,3));
Probe("Global.MATH_MIN.mixed",MATH_MIN(-2,3));
Probe("Global.MATH_MINI.integer",MATH_MINI(-2,3));
Probe("Global.MATH_MOD.negative",MATH_MOD(-7,3));
Probe("Global.MATH_POW.negativeInteger",MATH_POW(-2,3));
Probe("Global.MATH_REAL.integer",MATH_REAL(4));
Probe("Global.MATH_ROUND.negative",MATH_ROUND(-1.6));
Probe("Global.MATH_SIGN.zero",MATH_SIGN(0));
Probe("Global.MATH_SIN.quarterTurn",MATH_SIN(1.57079632679));
Probe("Global.MATH_SIN.twoArg",MATH_SIN(0.7,2));
Probe("Global.MATH_SIN_POW.negativeCurve",MATH_SIN_POW(0.7,-1));
Probe("Global.MATH_SQRT.negative",MATH_SQRT(-4));
Probe("Global.MATH_TAN.zero",MATH_TAN(0));
Probe("Global.MATH_LN.one",MATH_LN(1));
Probe("Global.MATH_LOG.one",MATH_LOG(1));

Probe("Global.MATHUTIL_GETINRANGE.low",MATHUTIL_GETINRANGE(-2,0,10));
Probe("Global.MATHUTIL_GETINRANGE.reversed",MATHUTIL_GETINRANGE(4,10,0));
Probe("Global.MATHUTIL_GETINRANGEI.truncate",MATHUTIL_GETINRANGEI(4.8,0,10));
Probe("Global.MATHUTIL_DEGTORAD.halfTurn",MATHUTIL_DEGTORAD(180));
Probe("Global.MATHUTIL_GetPercentageInRange.mid",MATHUTIL_GetPercentageInRange(5,0,10));
Probe("Global.MATHUTIL_GetPercentageInRange.zeroSpan",MATHUTIL_GetPercentageInRange(5,2,2));
Probe("Global.MATHUTIL_GetTrianglePercentage.peak",MATHUTIL_GetTrianglePercentage(0.5,0.5));
Probe("Global.MATHUTIL_GetTrianglePercentage.rising",MATHUTIL_GetTrianglePercentage(0.25,0.5));
Probe("Global.MATHUTIL_GetAngleRad.quadrantTwo",MATHUTIL_GetAngleRad(vector2D(-1,1)));
Probe("Global.MATHUTIL_GetAngleRad360.negative",MATHUTIL_GetAngleRad360(vector2D(0,-1)));
local rotated=MATHUTIL_Rotate(vector2D(2,0),1.57079632679);
Probe("Global.MATHUTIL_Rotate.x",rotated.x);
Probe("Global.MATHUTIL_Rotate.y",rotated.y);
Probe("Global.MATHUTIL_GetRadiansBetween.wrap",MATHUTIL_GetRadiansBetween(vector2D(-1,0.01),vector2D(-1,-0.01)));
Probe("Global.MATHUTIL_GetSignedAngleDistance.wrap",MATHUTIL_GetSignedAngleDistance(3.1,-3.1));
Probe("Global.MATHUTIL_GetAngleDistance.wrap",MATHUTIL_GetAngleDistance(3.1,-3.1));
Probe("Global.MATHUTIL_GetAngleDistancePositive.wrap",MATHUTIL_GetAngleDistancePositive(3.1,-3.1));
Probe("Global.MATHUTIL_GetAngleDistanceNegative.wrap",MATHUTIL_GetAngleDistanceNegative(3.1,-3.1));
Probe("Global.MATHUTIL_distance.diagonal",MATHUTIL_distance(vector2D(1,2),vector2D(4,6)));
local centroidPoints=table();
centroidPoints[0]=vector2D(0,0); centroidPoints[1]=vector2D(6,3);
local centroid=MATHUTIL_GetCentroid(centroidPoints,2);
Probe("Global.MATHUTIL_GetCentroid.x",centroid.x);
Probe("Global.MATHUTIL_GetCentroid.y",centroid.y);
local intersections=table();
MATHUTIL_FindCircleCircleIntersection(vector2D(0.0,0.0),5.0,vector2D(6.0,0.0),5.0,intersections);
Probe("Global.MATHUTIL_FindCircleCircleIntersection.found",intersections.found);
Probe("Global.MATHUTIL_FindCircleCircleIntersection.firstX",intersections.p1.x);
Probe("Global.MATHUTIL_FindCircleCircleIntersection.firstY",intersections.p1.y);
Probe("Global.MATHUTIL_FindCircleCircleIntersection.secondX",intersections.p2.x);
Probe("Global.MATHUTIL_FindCircleCircleIntersection.secondY",intersections.p2.y);
local scalarIntersections=table();
MATHUTIL_FindCircleCircleIntersection(0.0,0.0,6.0,5.0,0.0,5.0,scalarIntersections);
Probe("Global.MATHUTIL_FindCircleCircleIntersection.scalarArgs.found",scalarIntersections.found);
Probe("Global.MATHUTIL_FindCircleCircleIntersection.scalarArgs.firstX",scalarIntersections.p1.x);
Probe("Global.MATHUTIL_FindCircleCircleIntersection.scalarArgs.firstY",scalarIntersections.p1.y);
Probe("Global.MATHUTIL_FindCircleCircleIntersection.scalarArgs.secondX",scalarIntersections.p2.x);
Probe("Global.MATHUTIL_FindCircleCircleIntersection.scalarArgs.secondY",scalarIntersections.p2.y);
local noIntersection=table();
MATHUTIL_FindCircleCircleIntersection(vector2D(0.0,0.0),1.0,vector2D(4.0,0.0),1.0,noIntersection);
Probe("Global.MATHUTIL_FindCircleCircleIntersection.noHit",noIntersection.found);
local closest=MATHUTIL_FindClosestPointOnLine(vector2D(0,0),vector2D(2,0),vector2D(3,4));
Probe("Global.MATHUTIL_FindClosestPointOnLine.x",closest.x);
Probe("Global.MATHUTIL_FindClosestPointOnLine.y",closest.y);
local closestSegment=MATHUTIL_GetClosestPointOnLineSegment(vector2D(0,0),vector2D(2,0),vector2D(3,4));
Probe("Global.MATHUTIL_GetClosestPointOnLineSegment.x",closestSegment.x);
Probe("Global.MATHUTIL_GetClosestPointOnLineSegment.y",closestSegment.y);
Probe("Global.MATHUTIL_GetClosestDistanceFromLineToPoint.distance",MATHUTIL_GetClosestDistanceFromLineToPoint(vector2D(0,0),vector2D(2,0),vector2D(3,4)));
Probe("Global.MATHUTIL_GetClosestDistanceFromLineSegmentToPoint.distance",MATHUTIL_GetClosestDistanceFromLineSegmentToPoint(vector2D(0,0),vector2D(2,0),vector2D(3,4)));
Probe("Global.MATHUTIL_GetSeconds.millis",MATHUTIL_GetSeconds(1500));
Probe("Global.MATHUTIL_GetMinutes.millis",MATHUTIL_GetMinutes(90000));
Probe("Global.MATHUTIL_CalculateExponentialDecay.halfLife",MATHUTIL_CalculateExponentialDecay(0.01,100));
Probe("Global.MATHUTIL_CalculateExponentialDecayReversed.halfLife",MATHUTIL_CalculateExponentialDecayReversed(0.01,100));
MATHUTIL_CalculateExponentialGrowth(0.01,100);
Probe("Global.MATHUTIL_CalculateExponentialGrowth.called",1);

local v=vector2D(3,4);
Probe("vector2D.length.pythagorean",v.length());
Probe("vector2D.lengthSquared.pythagorean",v.lengthSquared());
local normalized=v.getNormalized();
Probe("vector2D.getNormalized.x",normalized.x);
Probe("vector2D.getNormalized.y",normalized.y);
local left=v.getLeftNormal();
Probe("vector2D.getLeftNormal.x",left.x);
Probe("vector2D.getLeftNormal.y",left.y);
local right=v.getRightNormal();
Probe("vector2D.getRightNormal.x",right.x);
Probe("vector2D.getRightNormal.y",right.y);
local toPoint=v.getVectorToPoint(vector2D(6,8));
Probe("vector2D.getVectorToPoint.x",toPoint.x);
Probe("vector2D.getVectorToPoint.y",toPoint.y);
local toPointUnit=v.getVectorToPointNormalized(vector2D(6,8));
Probe("vector2D.getVectorToPointNormalized.x",toPointUnit.x);
Probe("vector2D.getVectorToPointNormalized.y",toPointUnit.y);
Probe("vector2D.distance.euclidean",v.distance(vector2D(6,8)));
Probe("vector2D.isPrettyMuchEqual.inside",v.isPrettyMuchEqual(vector2D(3.02,4)));
Probe("vector2D.isPrettyMuchEqual.outside",v.isPrettyMuchEqual(vector2D(3.04,4)));
Probe("vector2D.isZeroVector.nonzero",v.isZeroVector());
Probe("vector2D.isvector2D.true",v.isvector2D(v));
Probe("vector2D.isvector2D.false",v.isvector2D(0));
Probe("vector2D.scalarProjectOnto.xAxis",v.scalarProjectOnto(vector2D(2,0)));
local projection=v.vectorProjectOnto(vector2D(2,0));
Probe("vector2D.vectorProjectOnto.x",projection.x);
Probe("vector2D.vectorProjectOnto.y",projection.y);
local zero=vector2D(0,0);
Probe("vector2D.getNormalized.zeroX",zero.getNormalized().x);
Probe("vector2D.getVectorToPointNormalized.sameX",zero.getVectorToPointNormalized(zero).x);

global Main=function(p) {
    return table(Process=p,constructor=function(){},init=function(){return true;},update=function(){});
};
