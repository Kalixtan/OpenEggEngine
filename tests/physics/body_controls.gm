global Probe=function(name,value) {
    GameMonkeyScript.loadScript("OEP__"+name+"__"+value+".gm");
};
GameMonkeyScript.loadScript("EntityQueryProbeEntity.gm");
global BodyShape=PHYSICSSHAPECOLLECTIONDEF();
global Main=function(p) {
    return table(Process=p,ran=0,constructor=function(){},init=function(){return true;},
        update=function() {
            if (this.ran==1) { this.ran=2; this.sleepWait=0; }
            if (this.ran==2) {
                this.sleepWait+=1;
                if (this.sleepWait<30) { return; }
                Probe("bodyCtl.sleeping",this.sleepBody.isSleeping());
                GameSystem.setIsShouldUpdateEntities(0);
                Probe("bodyCtl.updateEntitiesOff",GameSystem.isShouldUpdateEntities());
                GameSystem.setIsShouldUpdateEntities(1);
                Probe("bodyCtl.updateEntitiesOn",GameSystem.isShouldUpdateEntities());
                Probe("bodyCtl.updateInterval",GameSystem.getUpdateInterval());
                this.ran=3;
                GameSystem.setIsShouldUpdateEntities(1);
                Probe("bodyCtl.shapeSensorInvalidReached",1);
                this.body.setIsShapeSensor(10,1);
                Probe("bodyCtl.shapeSensorInvalidContinues",this.body.isShapeSensor(0));
                Probe("bodyCtl.shapeMaskGetterInvalidReached",1);
                Probe("bodyCtl.shapeMaskGetterInvalid",
                    this.body.getShapeCategoriesToCollideWith(10));
                this.body.setShapeCategoriesToCollideWith(10,3);
                Probe("bodyCtl.shapeMaskInvalid",this.body.getShapeCategoriesToCollideWith(0));
                return;
            }
            if (this.ran) { return; }
            this.ran=1;
            GameSystem.setIsShouldUpdateEntities(0);
            local entity=EntityManager.createEntity("EntityQueryProbeEntity");
            local pd=entity.getPhysicsData();
            local body=pd.getBody(pd.createBody());
            this.body=body;
            body.setPos(vector2D(4,5));
            BodyShape.reset();
            BodyShape.setMass(2);
            BodyShape.addCircle(1,0,0);
            body.appendShapes(BodyShape);
            entity.setIsEnabled(1);
            EntityManager.flush();

            body.setPos(4,5);
            local pos=body.getPos();
            Probe("bodyCtl.position",pos.x==4 && pos.y==5);
            body.setVel(vector2D(3,4));
            local vel=body.getVel();
            Probe("bodyCtl.velocity",vel.x==3 && vel.y==4);
            Probe("bodyCtl.speed",body.getSpeed());
            body.setSpeed(10);
            Probe("bodyCtl.setSpeed",body.getSpeed());
            local direction=body.getDir();
            Probe("bodyCtl.direction",direction.x==1 && direction.y==0);
            body.setMass(3);
            Probe("bodyCtl.mass",body.getMass());
            body.setMaxSpeed(12);
            Probe("bodyCtl.maxSpeed",body.getMaxSpeed());
            body.setMaxRotateSpeed(2);
            Probe("bodyCtl.maxRotateSpeed",body.getMaxRotateSpeed());
            body.setFriction(0.25);
            Probe("bodyCtl.friction",body.getFriction());
            body.setRestitution(0.75);
            Probe("bodyCtl.restitution",body.getRestitution());
            body.setIsSensor(1);
            Probe("bodyCtl.sensor",body.isSensor());
            body.setIsCollidable(0);
            Probe("bodyCtl.collidable",body.isCollidable());
            body.setIsBullet(1);
            Probe("bodyCtl.bullet",body.isBullet());
            body.setCollisionCategory(4);
            Probe("bodyCtl.category",body.getCollisionCategory());
            body.setCategoriesToCollideWith(7);
            Probe("bodyCtl.mask",body.getCategoriesToCollideWith());
            body.setCollisionGroup(-2);
            Probe("bodyCtl.group",body.getCollisionGroup());
            body.setAngularVel(0.5);
            Probe("bodyCtl.angularVelocity",body.getAngularVel());
            Probe("bodyCtl.computeAngularVelBefore",body.getAngularVel());
            body.computeAngularVel(0.75,0.5);
            Probe("bodyCtl.computeAngularVelAfter",body.getAngularVel());
            Probe("bodyCtl.computeAngularVelRotate",body.getRotateVel());
            Probe("bodyCtl.shapeCount",body.getNumShapes());
            Probe("bodyCtl.pointInside",body.isPointWithin(vector2D(4,5)));
            Probe("bodyCtl.pointOutside",body.isPointWithin(vector2D(8,8)));
            this.sleepEntity=EntityManager.createEntity("EntityQueryProbeEntity");
            local sleepData=this.sleepEntity.getPhysicsData();
            this.sleepBody=sleepData.getBody(sleepData.createBody());
            this.sleepBody.setPos(vector2D(100,100));
            BodyShape.reset();
            BodyShape.setMass(1);
            BodyShape.addCircle(1,0,0);
            this.sleepBody.appendShapes(BodyShape);
            this.sleepEntity.setIsEnabled(1);
            EntityManager.flush();
            this.sleepBody.setAllowSleeping(1);
            this.sleepBody.putToSleep();

            Probe("bodyApi.physicsBody.doesRotationResponse",body.doesRotationResponse());
            Probe("bodyApi.physicsBody.getAngularVel",body.getAngularVel());
            Probe("bodyApi.physicsBody.getBrakeAcc",body.getBrakeAcc());
            Probe("bodyApi.physicsBody.getCategoriesToCollideWith",body.getCategoriesToCollideWith());
            Probe("bodyApi.physicsBody.getCollisionCategory",body.getCollisionCategory());
            Probe("bodyApi.physicsBody.getCollisionGroup",body.getCollisionGroup());
            Probe("bodyApi.physicsBody.getFriction",body.getFriction());
            Probe("bodyApi.physicsBody.getMass",body.getMass());
            Probe("bodyApi.physicsBody.getMaxRotateSpeed",body.getMaxRotateSpeed());
            Probe("bodyApi.physicsBody.getMaxSpeed",body.getMaxSpeed());
            Probe("bodyApi.physicsBody.getNumShapeVerts",body.getNumShapeVerts(0));
            Probe("bodyApi.physicsBody.getRadius",body.getRadius());
            Probe("bodyApi.physicsBody.getRestitution",body.getRestitution());
            Probe("bodyApi.physicsBody.getRotateAcc",body.getRotateAcc());
            Probe("bodyApi.physicsBody.getRotateVel",body.getRotateVel());
            Probe("bodyApi.physicsBody.getShapeCategoriesToCollideWith",body.getShapeCategoriesToCollideWith(0));
            Probe("bodyApi.physicsBody.getShapeHeight",body.getShapeHeight(0));
            Probe("bodyApi.physicsBody.getShapeRadius",body.getShapeRadius(0));
            Probe("bodyApi.physicsBody.getShapeType",body.getShapeType(0));
            Probe("bodyApi.physicsBody.getShapeWidth",body.getShapeWidth(0));
            Probe("bodyApi.physicsBody.getSpeed",body.getSpeed());
            Probe("bodyApi.physicsBody.getThrustAcc",body.getThrustAcc());
            Probe("bodyApi.physicsBody.isCircle",body.isCircle());
            Probe("bodyApi.physicsBody.isContainsShape",body.isContainsShape(body.getShapeObjectID(0)));
            Probe("bodyApi.physicsBody.isPointWithinShape",body.isPointWithinShape(vector2D(4,5),0));
            Probe("bodyApi.physicsBody.isRect",body.isRect());
            Probe("bodyApi.physicsBody.isShapeSensor",body.isShapeSensor(0));
            Probe("bodyApi.physicsBody.getCenterOfMass",body.getCenterOfMass().x);
            Probe("bodyApi.physicsBody.getPosRef",body.getPosRef().x);
            Probe("bodyApi.physicsBody.getPosVec",body.getPosVec().y);
            Probe("bodyApi.physicsBody.getVelRef",body.getVelRef().x);
            Probe("bodyApi.physicsBody.getWidth",body.getWidth());
            Probe("bodyApi.physicsBody.getHeight",body.getHeight());
            Probe("bodyApi.physicsBody.getMinPos",body.getMinPos().x);
            Probe("bodyApi.physicsBody.getMaxPos",body.getMaxPos().x);
            Probe("bodyApi.physicsBody.getShapeIndex",body.getShapeIndex(body.getShapeObjectID(0)));
            Probe("bodyApi.physicsBody.getShapeOffset",body.getShapeOffset(0).x);
            Probe("bodyApi.physicsBody.getShapeWorldCenterPos",body.getShapeWorldCenterPos(0).x);
            Probe("bodyApi.physicsBody.getShapeWorldVert",body.getShapeWorldVert(0,0).x);
            Probe("bodyApi.physicsBody.getWorldDir",body.getWorldDir(vector2D(1,0)).x);
            Probe("bodyApi.physicsBody.getWorldPos",body.getWorldPos(vector2D(1,0)).x);
            Probe("bodyApi.physicsBody.isBullet",body.isBullet());
            Probe("bodyApi.physicsBody.isSensor",body.isSensor());

            Probe("bodyApi.physicsData.getPos",pd.getPos().x);
            Probe("bodyApi.physicsData.getPosRef",pd.getPosRef().y);
            Probe("bodyApi.physicsData.getVel",pd.getVel().x);
            Probe("bodyApi.physicsData.getMinPos",pd.getMinPos().x);
            Probe("bodyApi.physicsData.getMaxPos",pd.getMaxPos().x);
            Probe("bodyApi.physicsData.isPointWithin",pd.isPointWithin(vector2D(4,5)));

            Probe("bodyApi.physicsData.doesRotationResponse",pd.doesRotationResponse());
            Probe("bodyApi.physicsData.getBrakeAcc",pd.getBrakeAcc());
            Probe("bodyApi.physicsData.getCategoriesToCollideWith",pd.getCategoriesToCollideWith());
            Probe("bodyApi.physicsData.getCollisionCategory",pd.getCollisionCategory());
            Probe("bodyApi.physicsData.getCollisionGroup",pd.getCollisionGroup());
            Probe("bodyApi.physicsData.getHeight",pd.getHeight());
            Probe("bodyApi.physicsData.getMass",pd.getMass());
            Probe("bodyApi.physicsData.getMaxRotateSpeed",pd.getMaxRotateSpeed());
            Probe("bodyApi.physicsData.getMaxSpeed",pd.getMaxSpeed());
            Probe("bodyApi.physicsData.getNumBodies",pd.getNumBodies());
            Probe("bodyApi.physicsData.getRadius",pd.getRadius());
            Probe("bodyApi.physicsData.getRotateAcc",pd.getRotateAcc());
            Probe("bodyApi.physicsData.getShapeRadius",pd.getShapeRadius(0,0));
            Probe("bodyApi.physicsData.getSpeed",pd.getSpeed());
            Probe("bodyApi.physicsData.getThrustAcc",pd.getThrustAcc());
            Probe("bodyApi.physicsData.getType",pd.getType());
            Probe("bodyApi.physicsData.getWidth",pd.getWidth());
            Probe("bodyApi.physicsData.isCircle",pd.isCircle());
            Probe("bodyApi.physicsData.isCollidable",pd.isCollidable());
            Probe("bodyApi.physicsData.isRect",pd.isRect());
            Probe("bodyApi.physicsData.isSensor",pd.isSensor());

            local shape= pd.getShapeByID(body.getShapeObjectID(0));
            Probe("bodyApi.physicsShape.getIsSensor",shape.getIsSensor());
            Probe("bodyApi.physicsShape.getType",shape.getType());
            Probe("bodyApi.physicsShape.getVertexCount",shape.getVertexCount());
            Probe("bodyApi.physicsShape.getVertexWorldPos",shape.getVertexWorldPos(0).x);
            Probe("bodyApi.physicsShape.isSensor",shape.isSensor());
            shape.setCategoriesToCollideWith(7);
            Probe("bodyApi.physicsShape.setCategoriesToCollideWith",1);
            shape.setCollisionCategory(4);
            Probe("bodyApi.physicsShape.setCollisionCategory",1);
            shape.setFrictionForPlayer(0.33);
            Probe("bodyApi.physicsShape.setFrictionForPlayer",1);
            shape.setIsSensor(1);
            Probe("bodyApi.physicsShape.setIsSensor",shape.isSensor());

            local shapeDef=BodyShape;
            shapeDef.reset();
            shapeDef.setFriction(0.4);
            Probe("bodyApi.shapeDef.setFriction",1);
            Probe("bodyApi.shapeDef.getFriction",shapeDef.getFriction());
            shapeDef.setRestitution(0.6);
            Probe("bodyApi.shapeDef.setRestitution",shapeDef.getRestitution());
            shapeDef.setFrictionForPlayer(0.25);
            Probe("bodyApi.shapeDef.setFrictionForPlayer",1);
            shapeDef.setCollisionCategory(8);
            Probe("bodyApi.shapeDef.setCollisionCategory",shapeDef.getCollisionCategory());
            shapeDef.setCategoriesToCollideWith(11);
            Probe("bodyApi.shapeDef.setCategoriesToCollideWith",shapeDef.getCategoriesToCollideWith());
            shapeDef.reset();
            Probe("bodyApi.shapeDef.reset",shapeDef.getCollisionCategory());
            shapeDef.addBox(2,3,0,0,0);
            Probe("bodyApi.shapeDef.addBox",1);
            shapeDef.setMass(2);
            Probe("bodyApi.shapeDef.setMass",shapeDef.getMass());
            shapeDef.setIsSensor(1);
            Probe("bodyApi.shapeDef.setIsSensor",shapeDef.isSensor());
            Probe("bodyApi.shapeDef.getRestitution",shapeDef.getRestitution());
            shapeDef.reset();
            local verts={vector2D(-1,-1),vector2D(1,-1),vector2D(0,1)};
            shapeDef.addPolygon(verts,3);
            Probe("bodyApi.shapeDef.addPolygon",1);
            shapeDef.reset();
            shapeDef.addEdges(verts,3,true);
            Probe("bodyApi.shapeDef.addEdges",1);

            this.sleepBody.wakeUp();
            this.sleepBody.setPos(vector2D(200,200));
            this.sleepBody.setVel(vector2D(1,0));
            Physics.flush();
            Probe("bodyCtl.flushAfterOne",this.sleepBody.getPos().x);
            local flushIndex=0;
            for (flushIndex=0;flushIndex<9;flushIndex+=1) {
                Physics.flush();
            }
            Probe("bodyCtl.flushAfterTen",this.sleepBody.getPos().x);

            this.bodyLifeEntity=EntityManager.createEntity("EntityQueryProbeEntity");
            local bodyLifeData=this.bodyLifeEntity.getPhysicsData();
            local bodyLifeIndex=bodyLifeData.createBody();
            bodyLifeData.getBody(bodyLifeIndex).setPos(vector2D(240,250));
            local replaced=bodyLifeData.replaceBody(0);
            Probe("bodyCtl.replaceBodyExists",?replaced);
            Probe("bodyCtl.replaceBodyCount",bodyLifeData.getNumBodies());
            Probe("bodyCtl.replaceBodyPos",replaced.getPos().x);
            Probe("bodyCtl.replaceBodyOutOfRangeExists",?bodyLifeData.replaceBody(10));
            bodyLifeData.removeBody(replaced.getObjectID());
            Probe("bodyCtl.removeBodyCount",bodyLifeData.getNumBodies());
            bodyLifeData.createBody();
            Probe("bodyCtl.removeAllBodyBefore",bodyLifeData.getNumBodies());
            bodyLifeData.removeBody();
            Probe("bodyCtl.removeAllBodyAfter",bodyLifeData.getNumBodies());
            local appendIndex=bodyLifeData.createBody();
            BodyShape.reset();
            BodyShape.setMass(1);
            BodyShape.addCircle(2,0,0);
            Probe("bodyCtl.dataAppendFirst",bodyLifeData.appendShapes(appendIndex,BodyShape));
            Probe("bodyCtl.dataAppendSecond",bodyLifeData.appendShapes(appendIndex,BodyShape));
            Probe("bodyCtl.dataAppendShapeCount",bodyLifeData.getBody(appendIndex).getNumShapes());
            body.setDir(vector2D(0,2));
            Probe("bodyCtl.directionSetX",body.getDir().x);
            Probe("bodyCtl.directionSetY",body.getDir().y);
            body.setRotateVel(0.25);
            Probe("bodyCtl.rotateVelSet",body.getRotateVel());
            local bodyBounds=body.getAABB();
            Probe("bodyCtl.bodyBoundsMinX",bodyBounds.minx);
            Probe("bodyCtl.bodyBoundsMaxX",bodyBounds.maxx);
            Probe("bodyCtl.bodyBoundsMinY",bodyBounds.miny);
            Probe("bodyCtl.bodyBoundsMaxY",bodyBounds.maxy);
            local dataBounds=pd.getAABB();
            Probe("bodyCtl.dataBoundsMinX",dataBounds.minx);
            Probe("bodyCtl.dataBoundsMaxX",dataBounds.maxx);
            Probe("bodyCtl.dataBoundsMinY",dataBounds.miny);
            Probe("bodyCtl.dataBoundsMaxY",dataBounds.maxy);
            body.setVel(vector2D(0,0));
            body.setAngularVel(0);
            local bodyPos=body.getPos();
            local forcePoint=vector2D(bodyPos.x,bodyPos.y+1);
            body.applyForce(vector2D(100,0),forcePoint);
            Physics.flush();
            Probe("bodyCtl.forceAfterOneX",body.getVel().x);
            Probe("bodyCtl.forceAfterOneAngular",body.getAngularVel());
            for (flushIndex=0;flushIndex<9;flushIndex+=1) {
                Physics.flush();
            }
            Probe("bodyCtl.forceAfterTenX",body.getVel().x);
            Probe("bodyCtl.forceAfterTenAngular",body.getAngularVel());
            Probe("bodyCtl.ownerMatches",body.getEntity().getObjectID()==entity.getObjectID());
            Probe("bodyCtl.bodyIDPositive",body.getObjectID()>0);
            Probe("bodyCtl.shapeIDPositive",body.getShapeObjectID(0)>0);
            body.setVel(vector2D(0,0));
            body.setAngularVel(0);
            Probe("bodyCtl.shapeDensityBefore",1);
            body.setShapeDensity(0,2);
            Probe("bodyCtl.shapeDensityAfter",1);
            Probe("bodyCtl.shapeDensityValidMass",body.getMass());
            body.setShapeDensity(10,3);
            Probe("bodyCtl.shapeDensityInvalidMass",body.getMass());
            body.setShapeCategoriesToCollideWith(0,5);
            Probe("bodyCtl.shapeMaskValid",body.getShapeCategoriesToCollideWith(0));
            body.setIsShapeSensor(0,0);
            Probe("bodyCtl.shapeSensorOff",body.isShapeSensor(0));
            body.setIsShapeSensor(0,1);
            Probe("bodyCtl.shapeSensorOn",body.isShapeSensor(0));
        });
};
