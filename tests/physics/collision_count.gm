global Probe=function(name,value) {
    GameMonkeyScript.loadScript("OEP__"+name+"__"+value+".gm");
};
global Shapes=PHYSICSSHAPECOLLECTIONDEF();
global Main=function(p) {
    return table(Process=p,frame=0,constructor=function(){},init=function(){return true;},
        update=function() {
            if (this.frame==0) {
                this.a=EntityManager.createEntity();
                this.b=EntityManager.createEntity();
                this.ad=this.a.getPhysicsData();
                this.bd=this.b.getPhysicsData();
                this.ab=this.ad.getBody(this.ad.createBody());
                this.bb=this.bd.getBody(this.bd.createBody());
                this.ab.setPos(vector2D(0,500));
                this.bb.setPos(vector2D(3,500));
                Shapes.reset();
                Shapes.setMass(1);
                Shapes.addCircle(2,0,0);
                this.ab.appendShapes(Shapes);
                this.bb.appendShapes(Shapes);
                this.a.setIsEnabled(1);
                this.b.setIsEnabled(1);
                EntityManager.flush();
            } else if (this.frame==2) {
                local info=this.ad.getCollisionInfo(this.b);
                Probe("collisionInfo.getNumCollidingShapes.entered",1);
                Probe("collisionInfo.getNumCollidingShapes.count",
                    info.getNumCollidingShapes());
                Probe("collisionInfo.getNumCollidingShapes.after",1);
                this.frame=3;
                return;
            }
            this.frame+=1;
        });
};
