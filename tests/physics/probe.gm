global Probe=function(name,value) {
    GameMonkeyScript.loadScript("OEP__"+name+"__"+value+".gm");
};

local e=EntityManager.createEntity();
Probe("EntityManager.createEntity.exists",e!=null);
local pd=e.getPhysicsData();
Probe("Entity.getPhysicsData.exists",pd!=null);
Probe("PhysicsData.getNumBodies.initial",pd.getNumBodies());
Probe("PhysicsData.isSensor.noBodies",pd.isSensor());
Probe("PhysicsData.getNumBodies.afterSensorQuery",pd.getNumBodies());
Probe("PhysicsData.createBody.index",pd.createBody());
Probe("PhysicsData.getNumBodies.created",pd.getNumBodies());
local b=pd.getBody(0);
Probe("PhysicsData.getBody.exists",?b);
Probe("PhysicsBody.getNumShapes.initial",b.getNumShapes());
Probe("PhysicsBody.isSensor.empty",b.isSensor());
Probe("PhysicsData.isSensor.empty",pd.isSensor());
Probe("PhysicsBody.getPos.x.initial",b.getPos().x);
Probe("PhysicsBody.getPos.y.initial",b.getPos().y);
b.setPos(vector2D(12,-7));
Probe("PhysicsBody.getPos.x.set",b.getPos().x);
Probe("PhysicsBody.getPos.y.set",b.getPos().y);
b.setVel(vector2D(0.125,-0.25));
Probe("PhysicsBody.getVel.x.set",b.getVel().x);
Probe("PhysicsBody.getVel.y.set",b.getVel().y);
Probe("PhysicsBody.getSpeed.set",b.getSpeed());
local sd=PHYSICSSHAPECOLLECTIONDEF();
Probe("ShapeDef.getMass.initial",sd.getMass());
sd.setMass(2);
Probe("ShapeDef.getMass.set",sd.getMass());
Probe("ShapeDef.isSensor.initial",sd.isSensor());
sd.setIsSensor(1);
Probe("ShapeDef.isSensor.set",sd.isSensor());
sd.setIsSensor(0);
Probe("ShapeDef.isSensor.reset",sd.isSensor());
Probe("ShapeDef.getCollisionCategory.initial",sd.getCollisionCategory());
sd.setCollisionCategory(8);
Probe("ShapeDef.getCollisionCategory.set",sd.getCollisionCategory());
sd.setCategoriesToCollideWith(11);
Probe("ShapeDef.getCategoriesToCollideWith.set",sd.getCategoriesToCollideWith());
sd.addCircle(5,0,0);
Probe("PhysicsBody.appendShapes.index",b.appendShapes(sd));
Probe("PhysicsBody.getNumShapes.circle",b.getNumShapes());
Probe("PhysicsBody.getRadius.circle",b.getRadius());
Probe("PhysicsBody.getShapeRadius.circle",b.getShapeRadius(0));
Probe("PhysicsBody.getShapeType.circle",b.getShapeType(0));
Probe("PhysicsBody.getShapeWidth.circle",b.getShapeWidth(0));
Probe("PhysicsBody.getShapeHeight.circle",b.getShapeHeight(0));
Probe("PhysicsBody.getCollisionCategory.fromDef",b.getCollisionCategory());
Probe("PhysicsBody.getCategoriesToCollideWith.fromDef",b.getCategoriesToCollideWith());
b.setCollisionCategory(4);
Probe("PhysicsBody.getCollisionCategory.set",b.getCollisionCategory());
b.setCategoriesToCollideWith(7);
Probe("PhysicsBody.getCategoriesToCollideWith.set",b.getCategoriesToCollideWith());
Probe("PhysicsBody.isPointWithin.inside",b.isPointWithin(vector2D(12,-7)));
Probe("PhysicsBody.isPointWithin.outside",b.isPointWithin(vector2D(30,30)));
b.setIsSensor(1);
Probe("PhysicsBody.isSensor.set",b.isSensor());
Probe("PhysicsData.isSensor.set",pd.isSensor());
b.setIsSensor(0);
Probe("PhysicsBody.isSensor.reset",b.isSensor());
Probe("PhysicsData.isSensor.reset",pd.isSensor());
Probe("PhysicsData.createBody.second",pd.createBody());
local b2=pd.getBody(1);
Probe("PhysicsBody.appendShapes.second",b2.appendShapes(sd));
b.setIsSensor(1);
Probe("PhysicsData.isSensor.mixed",pd.isSensor());
pd.setIsSensor(1);
Probe("PhysicsBody.isSensor.firstAfterDataSet",b.isSensor());
Probe("PhysicsBody.isSensor.secondAfterDataSet",b2.isSensor());
Probe("PhysicsData.isSensor.allSet",pd.isSensor());
pd.setIsSensor(0);
Probe("PhysicsBody.isSensor.firstAfterDataReset",b.isSensor());
Probe("PhysicsBody.isSensor.secondAfterDataReset",b2.isSensor());
Probe("PhysicsData.isSensor.allReset",pd.isSensor());
Probe("Physics.getNumFramesToIgnoreCollisions.initial",Physics.getNumFramesToIgnoreCollisions());
Physics.setNumFramesToIgnoreCollisions(3);
Probe("Physics.getNumFramesToIgnoreCollisions.set",Physics.getNumFramesToIgnoreCollisions());
Physics.setNumFramesToIgnoreCollisions(0);
Probe("Physics.getNumFramesToIgnoreCollisions.reset",Physics.getNumFramesToIgnoreCollisions());

global Main=function(p) {
    return table(Process=p,constructor=function(){},init=function(){return true;},update=function(){});
};
