global Probe=function(name,value) {
    GameMonkeyScript.loadScript("OEP__"+name+"__"+value+".gm");
};
GameMonkeyScript.loadScript("EntityGCProbe.gm");
global GCPressure=table(stage=0,ids={},roots={});
global Main=function(p) {
    return table(Process=p,constructor=function(){},init=function(){return true;},
        update=function() {
            local state=GCPressure;
            if (state.stage==0) {
                GameSystem.setIsShouldUpdateEntities(0);
                local i=0;
                for (i=0;i<96;i+=1) {
                    local entity=EntityManager.createEntity("EntityGCProbe");
                    state.ids[i]=entity.getObjectID();
                    if ((i%16)==0) { state.roots[i/16]=entity; }
                }
                EntityManager.flush();
                GameMonkeyScript.clean(1);
                state.stage=1;
            } else if (state.stage==1) {
                Probe("gcPressure.countAfterCreate",
                    EntityManager.getNumEntities("EntityGCProbe"));
                Probe("gcPressure.rootCount",6);
                Probe("gcPressure.firstRootValid",
                    EntityManager.isEntityIDValid(state.roots[0].getObjectID()));
                local i=1;
                for (i=1;i<96;i+=3) {
                    local entity=EntityManager.getEntity(state.ids[i]);
                    if (entity!=null) { entity.tagForDeletion(); }
                }
                EntityManager.flush();
                Probe("gcPressure.countBeforeCollect",
                    EntityManager.getNumEntities("EntityGCProbe"));
                GameMonkeyScript.clean(1);
                state.stage=2;
            } else if (state.stage==2) {
                local valid=0;
                local i=0;
                for (i=0;i<96;i+=1) {
                    if (EntityManager.isEntityIDValid(state.ids[i])) { valid+=1; }
                }
                Probe("gcPressure.validAfterCollect",valid);
                Probe("gcPressure.retainedRootValid",
                    EntityManager.isEntityIDValid(state.roots[5].getObjectID()));
                Probe("gcPressure.totalAfterCollect",
                    EntityManager.getNumEntities("EntityGCProbe"));
                EntityManager.deleteAllEntities();
                EntityManager.flush();
                GameMonkeyScript.clean(1);
                state.stage=3;
            } else if (state.stage==3) {
                Probe("gcPressure.emptyAfterClear",
                    EntityManager.getNumEntities("EntityGCProbe"));
                Probe("gcPressure.oldIdsInvalid",
                    !EntityManager.isEntityIDValid(state.ids[95]));
                state.roots={};
                state.ids={};
                GameMonkeyScript.clean(1);
                state.stage=4;
            }
        });
};
