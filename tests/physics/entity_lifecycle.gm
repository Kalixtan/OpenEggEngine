global Probe=function(name,value) {
    GameMonkeyScript.loadScript("OEP__"+name+"__"+value+".gm");
};
GameMonkeyScript.loadScript("LifecycleProbeEntity.gm");
global ShapeDef=PHYSICSSHAPECOLLECTIONDEF();
global MakeLifecycleEntity=function(x,side,state) {
    local e=EntityManager.createEntity("LifecycleProbeEntity");
    e.lifeSide=side;
    e.lifeState=state;
    local pd=e.getPhysicsData();
    local body=pd.getBody(pd.createBody());
    body.setPos(vector2D(x,0));
    ShapeDef.reset();
    ShapeDef.setMass(1);
    ShapeDef.addCircle(2,0,0);
    body.appendShapes(ShapeDef);
    e.setIsEnabled(1);
    return table(e=e,pd=pd,body=body,id=e.getObjectID());
};
global NewLifeState=function() {
    return table(trace="",aP=0,aC=0,aT=0,aS=0,bP=0,bC=0,bT=0,bS=0);
};
global SampleLife=function(owner,tick) {
    local key="entityLife.pair.t"+tick+".";
    Probe(key+"aValid",EntityManager.isEntityIDValid(owner.a.id));
    Probe(key+"bValid",EntityManager.isEntityIDValid(owner.b.id));
    Probe(key+"aEnabled",owner.a.e.isEnabled());
    Probe(key+"aBodies",owner.a.pd.getNumBodies());
    Probe(key+"aColliding",owner.a.pd.isColliding(owner.b.e));
    Probe(key+"trace",owner.state.trace);
    Probe(key+"aP",owner.state.aP);
    Probe(key+"aC",owner.state.aC);
    Probe(key+"aT",owner.state.aT);
    Probe(key+"aS",owner.state.aS);
    Probe(key+"bP",owner.state.bP);
    Probe(key+"bC",owner.state.bC);
    Probe(key+"bT",owner.state.bT);
    Probe(key+"bS",owner.state.bS);
};
global Main=function(p) {
    return table(Process=p,frame=0,constructor=function(){},init=function(){return true;},
        update=function() {
            if (this.frame<9) {
                if (this.frame==0) {
                    GameSystem.setIsShouldUpdateEntities(1);
                    this.state=NewLifeState();
                    this.a=MakeLifecycleEntity(0,"a",this.state);
                    this.b=MakeLifecycleEntity(20,"b",this.state);
                }
                if (this.frame==1) { this.b.body.setPos(vector2D(3,0)); }
                if (this.frame==2) { this.a.e.setIsEnabled(0); }
                if (this.frame==3) { this.b.body.setPos(vector2D(20,0)); }
                if (this.frame==5) {
                    this.a.e.setIsEnabled(1);
                    this.b.body.setPos(vector2D(3,0));
                }
                if (this.frame<7) {
                    SampleLife(this,this.frame);
                } else if (this.frame==7) {
                    EntityManager.deleteAllEntities();
                    Probe("entityLife.delete.request.aValid",
                          EntityManager.isEntityIDValid(this.a.id));
                    Probe("entityLife.delete.request.bValid",
                          EntityManager.isEntityIDValid(this.b.id));
                } else {
                    Probe("entityLife.delete.afterFlush.aValid",
                          EntityManager.isEntityIDValid(this.a.id));
                    Probe("entityLife.delete.afterFlush.bValid",
                          EntityManager.isEntityIDValid(this.b.id));
                }
                this.frame+=1;
            }
        });
};
