global Probe=function(name,value) {
    GameMonkeyScript.loadScript("OEP__"+name+"__"+value+".gm");
};
GameMonkeyScript.loadScript("EntityStateProbeEntity.gm");
global StateShape=PHYSICSSHAPECOLLECTIONDEF();
global AddStateBody=function(entity,x,y) {
    local data=entity.getPhysicsData();
    local body=data.getBody(data.createBody());
    body.setPos(vector2D(x,y));
    StateShape.reset();
    StateShape.setMass(1);
    StateShape.addCircle(1,0,0);
    body.appendShapes(StateShape);
    entity.setIsEnabled(1);
    return body;
};

global Main=function(p) {
    return table(Process=p,ran=0,constructor=function(){},init=function(){return true;},
        update=function() {
            if (this.ran) { return; }
            this.ran=1;
            GameSystem.setIsShouldUpdateEntities(0);
            local entity=EntityManager.createEntity("EntityStateProbeEntity");
            local other=EntityManager.createEntity("EntityStateProbeEntity");
            local entityBody=AddStateBody(entity,0,0);
            local otherBody=AddStateBody(other,3,4);
            entityBody.setDir(vector2D(1,0));
            otherBody.setDir(vector2D(1,0));
            EntityManager.flush();
            local native=entity.Entity;
            local nativeOther=other.Entity;
            native.PhysicsData=entity.getPhysicsData();
            nativeOther.PhysicsData=other.getPhysicsData();
            Probe("entityState.hasAlwaysProcessedGetter",?native.isAlwaysProcessed);
            Probe("entityState.hasCreationPosGetter",?native.getEntityCreationPos);
            Probe("entityState.hasAddAlarm",?native.addAlarm);
            Probe("entityState.hasAddLFO",?native.addLFO);
            Probe("entityState.hasCallMethod",?native.callMethod);
            Probe("entityState.hasWhichSide",?native.getWhichSide);
            entity.setIsInvisible(1);
            entity.setIsStaticDraw(1);
            entity.setIsEditable(1);
            entity.setIsBeingEdited(1);
            entity.setIsPlacing(1);
            native.setIsAlwaysProcessed(1);
            entity.setIsSauceBase(1);
            entity.setDescriptionBits(37);
            native.setEntityCreationPos(vector2D(12.5,-4.25));
            entity.setLimitVolPerc(0.375);
            entity.setNumOffScreensAudible(3);
            entity.set_getAudibilityPerc_neverOnScreen(1);
            entity.setMixerID(7);

            Probe("entityState.invisible",entity.isInvisible());
            Probe("entityState.staticDraw",entity.isStaticDraw());
            Probe("entityState.editable",entity.isEditable());
            Probe("entityState.beingEdited",entity.isBeingEdited());
            Probe("entityState.placing",entity.isPlacing());
            Probe("entityState.alwaysProcessed",entity.isAlwaysProcessed());
            Probe("entityState.sauceBase",entity.isSauceBase());
            Probe("entityState.descriptionBits",entity.getDescriptionBits());
            local creationPos=entity.getEntityCreationPos();
            if (creationPos==null) {
                Probe("entityState.creationPosX","null");
                Probe("entityState.creationPosY","null");
            } else {
                Probe("entityState.creationPosX",creationPos.x);
                Probe("entityState.creationPosY",creationPos.y);
            }
            Probe("entityState.limitVolPerc",entity.getLimitVolPerc());
            Probe("entityState.offScreensAudible",entity.getNumOffScreensAudible());
            Probe("entityState.neverOnScreen",entity.is_getAudibilityPerc_neverOnScreen());
            Probe("entityState.mixerID",entity.getMixerID());
            Probe("entityState.typeName",entity.getTypeName());
            Probe("entityState.numericType",entity.getType());
            Probe("entityState.objectIDsDistinct",entity.getObjectID()!=other.getObjectID());
            Probe("entityState.isType",entity.isType("EntityStateProbeEntity"));
            Probe("entityState.wrongType",!entity.isType("MissingEntityType"));
            Probe("entityState.sameType",entity.isSameType(other));
            Probe("entityState.distance",entity.getDistanceTo(other));
            local vectorTo=entity.getVectorTo(other);
            Probe("entityState.vectorToX",vectorTo.x);
            Probe("entityState.vectorToY",vectorTo.y);
            local vectorNorm=entity.getVectorToNormalized(other);
            Probe("entityState.vectorNormX",vectorNorm.x);
            Probe("entityState.vectorNormY",vectorNorm.y);
            Probe("entityState.radiansToFace",entity.getRadiansToFace(other));
            Probe("entityState.whichSide",native.getWhichSide(native,nativeOther));
            otherBody.setPos(vector2D(3,-4));
            Probe("entityState.whichSideNegative",native.getWhichSide(native,nativeOther));
            otherBody.setPos(vector2D(-3,0));
            Probe("entityState.whichSideBehind",native.getWhichSide(native,nativeOther));
            otherBody.setPos(vector2D(3,4));
            Probe("entityState.mainBody","fixture-limited");
            Probe("entityState.createParticle",entity.createParticle("unused")==null);
            entity.deleteAllParticles();
            Probe("entityState.particleCount",entity.getNumParticles());
            local particles=entity.getAllParticles();
            if (particles==null) { Probe("entityState.particleIterator","null"); }
            else { Probe("entityState.particleIterator",particles.size()); }
            local attachedAlarm=native.addAlarm(91,100,0);
            Probe("entityState.attachedAlarmCreated",attachedAlarm!=null);
            local fetchedAlarm=native.getAlarm(91);
            Probe("entityState.attachedAlarmFound",fetchedAlarm!=null);
            Probe("entityState.attachedAlarmInterval",fetchedAlarm.getInterval());
            fetchedAlarm.update(25);
            Probe("entityState.attachedAlarmElapsed",fetchedAlarm.getMSElapsed());
            native.deleteAlarm(91);
            Probe("entityState.attachedAlarmDeleted",native.getAlarm(91)==null);
            local alarm=ALARM(100);
            Probe("entityState.alarmInterval",alarm.getInterval());
            Probe("entityState.alarmElapsedInitial",alarm.getMSElapsed());
            Probe("entityState.alarmInitiallyReady",alarm.isAlarming());
            Probe("entityState.alarmTimeInitial",alarm.getTimeTillAlarm());
            Probe("entityState.alarmUpdateEarly",alarm.update(40));
            Probe("entityState.alarmElapsedEarly",alarm.getMSElapsed());
            Probe("entityState.alarmUpdateReady",alarm.update(60));
            Probe("entityState.alarmReady",alarm.isAlarming());
            Probe("entityState.alarmPercentageReady",alarm.getAlarmPercentage());
            Probe("entityState.alarmEnabledReady",alarm.isEnabled());
            alarm.hardReset();
            Probe("entityState.alarmElapsedReset",alarm.getMSElapsed());
            alarm.setInterval(300);
            Probe("entityState.alarmIntervalSet",alarm.getInterval());
            Probe("entityState.alarmElapsedSetInterval",alarm.getMSElapsed());
            alarm.reset();
            Probe("entityState.alarmElapsedResetAlias",alarm.getMSElapsed());
            alarm.randomReset();
            Probe("entityState.alarmRandomResetRange",alarm.getAlarmPercentage()>=0 && alarm.getAlarmPercentage()<=1);
            alarm.setIntervalAndHardReset(200);
            Probe("entityState.alarmIntervalReset",alarm.getInterval());
            alarm.phaseReset(0.25);
            Probe("entityState.alarmElapsedPhase",alarm.getMSElapsed());
            alarm.setIsEnabled(0);
            Probe("entityState.alarmEnabledDisabled",alarm.isEnabled());
            Probe("entityState.alarmUpdateDisabled",alarm.update(50));
            Probe("entityState.alarmElapsedDisabled",alarm.getMSElapsed());
            local lfo=native.addLFO(0,TRIANGLELFO());
            Probe("entityState.addLFO",lfo!=null);
            local lfoProbe=TRIANGLELFO();
            Probe("entityState.lfoObjectNonNull",lfoProbe!=null);
            lfoProbe.setRate(200);
            lfoProbe.setRange(-1,1);
            lfoProbe.setPhase(0.25);
            Probe("entityState.lfoRate",lfoProbe.getRate());
            Probe("entityState.lfoValue",lfoProbe.getValue());
            lfoProbe.update(50);
            Probe("entityState.lfoUpdatedValue",lfoProbe.getValue());
            lfoProbe.setRate(50);
            Probe("entityState.lfoRate50",lfoProbe.getRate());
            lfoProbe.setRate(100);
            Probe("entityState.lfoRate100",lfoProbe.getRate());
            lfoProbe.setRate(400);
            Probe("entityState.lfoRate400",lfoProbe.getRate());
            lfoProbe.setPhase(0);
            Probe("entityState.lfoPhase0",lfoProbe.getValue());
            lfoProbe.setPhase(0.25);
            Probe("entityState.lfoPhaseQuarter",lfoProbe.getValue());
            lfoProbe.setPhase(0.5);
            Probe("entityState.lfoPhaseHalf",lfoProbe.getValue());
            lfoProbe.setPhase(0.75);
            Probe("entityState.lfoPhaseThreeQuarter",lfoProbe.getValue());
            lfoProbe.setContour(0.25,0.75);
            lfoProbe.setPhase(0.125);
            Probe("entityState.lfoContourBefore",lfoProbe.getValue());
            lfoProbe.setPhase(0.625);
            Probe("entityState.lfoContourAfter",lfoProbe.getValue());
            lfoProbe.setRange(-2,4);
            lfoProbe.setPhase(-0.25);
            Probe("entityState.lfoNegativePhase",lfoProbe.getValue());
            lfoProbe.setPhase(1.25);
            Probe("entityState.lfoPhaseAboveOne",lfoProbe.getValue());
            lfoProbe.setPhase(0.25);
            lfoProbe.update(0);
            Probe("entityState.lfoZeroDelta",lfoProbe.getValue());
            lfoProbe.update(-100);
            Probe("entityState.lfoNegativeDelta",lfoProbe.getValue());
            lfoProbe.setRate(0);
            lfoProbe.update(100);
            Probe("entityState.lfoZeroRate",lfoProbe.getValue());
            local alarmEdge=ALARM(100);
            Probe("entityState.alarmLargeStepReady",alarmEdge.update(250));
            Probe("entityState.alarmLargeStepElapsed",alarmEdge.getMSElapsed());
            Probe("entityState.alarmLargeStepPercentage",alarmEdge.getAlarmPercentage());
            alarmEdge.setInterval(0);
            Probe("entityState.alarmZeroIntervalReady",alarmEdge.update(0));
            Probe("entityState.alarmZeroIntervalPercentage",alarmEdge.getAlarmPercentage());
            alarmEdge.setInterval(100);
            alarmEdge.phaseReset(-0.5);
            Probe("entityState.alarmNegativePhase",alarmEdge.getMSElapsed());
            alarmEdge.phaseReset(1.5);
            Probe("entityState.alarmPhaseAboveOne",alarmEdge.getMSElapsed());
            entity.deleteLFO(0);
            entity.addTelescope();
            entity.clearTelescopes();
            entity.disownVoice();
            entity.forceAudibilityRecalc();
            entity.redrawSauceBase();
            entity.update();
            entity.updateExplosionIfGot();
            entity.die();
            Probe("entityState.compatibilityCallsComplete",1);
            Probe("entityState.gotDefault",!entity.isGot());
            entity.setGot(1);
            Probe("entityState.gotSet",entity.isGot());
            entity.setGot(0);
            Probe("entityState.gotCleared",!entity.isGot());
            Probe("entityState.getting",entity.isGetting());
            native.refreshFunctionCache();
            Probe("entityState.callMethod",native.callMethod("parityMethod",7));
            Probe("entityState.callMethodBehavior",entity.callMethod("parityMethod",7));
            Probe("entityState.callMethodMultiple",entity.callMethod("parityPair",3,4));
            Probe("entityState.callMethodMissing",entity.callMethod("missingParityMethod")==null);
            entity.initializeScreenExtents(2,4,2,4);
            Probe("entityState.screenMinX",entity.getMinCX());
            Probe("entityState.screenMaxX",entity.getMaxCX());
            Probe("entityState.screenMinY",entity.getMinCY());
            Probe("entityState.screenMaxY",entity.getMaxCY());
            Probe("entityState.onScreenInside",entity.isOnScreen(3));
            Probe("entityState.onScreenOutside",!entity.isOnScreen(5));
            Probe("entityState.notOkToRun",!entity.isOkToRun());

            entity.setIsInvisible(0);
            entity.setIsStaticDraw(0);
            entity.setIsEditable(0);
            entity.setIsBeingEdited(0);
            entity.setIsPlacing(0);
            entity.setIsAlwaysProcessed(0);
            entity.setIsSauceBase(0);
            entity.set_getAudibilityPerc_neverOnScreen(0);
            Probe("entityState.clearFlags",!entity.isInvisible() && !entity.isStaticDraw() &&
                !entity.isEditable() && !entity.isBeingEdited() && !entity.isPlacing() &&
                !entity.isAlwaysProcessed() && !entity.isSauceBase() &&
                !entity.is_getAudibilityPerc_neverOnScreen());
            GameSystem.setIsShouldUpdateEntities(1);
            Probe("entityState.okToRun",entity.isOkToRun());
            EntityManager.flush();
            entity.tagForDeletion();
            other.tagForDeletion();
            EntityManager.flush();
            Probe("entityState.deleted",!EntityManager.isEntityIDValid(entity.getObjectID()));
            Probe("entityState.otherDeleted",!EntityManager.isEntityIDValid(other.getObjectID()));
            local dummyA=EntityManager.getDummyEntity();
            local dummyB=EntityManager.getDummyEntity();
            Probe("entityState.dummyStable",dummyA.getObjectID()==dummyB.getObjectID());
            EntityManager.setEntityPerfCost("EntityStateProbeEntity",10,4);
            local costs=EntityManager.getEntityPerfCost("EntityStateProbeEntity");
            Probe("entityState.perfFirst",costs.firstInstCost);
            Probe("entityState.perfAdditional",costs.additionalInstCost);
            EntityManager.setEntityPerfMaxCost(42);
            Probe("entityState.perfMax",EntityManager.getEntityPerfMaxCost());
            Probe("entityState.perfMissing",EntityManager.getEntityPerfCost("MissingEntityType").cost);
            GameSystem.setIsShouldUpdateEntities(1);
        });
};
