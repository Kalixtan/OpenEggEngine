global Probe=function(name,value) {
    GameMonkeyScript.loadScript("OEP__"+name+"__"+value+".gm");
};
global Shapes=PHYSICSSHAPECOLLECTIONDEF();
global Main=function(p) {
    return table(Process=p,frame=0,constructor=function(){},init=function(){return true;},
        update=function() {
            if (this.frame==0) {
                this.a=EntityManager.createEntity();
                this.b=EntityManager.createEntity();
                this.c=EntityManager.createEntity();
                this.ad=this.a.getPhysicsData();
                this.bd=this.b.getPhysicsData();
                this.cd=this.c.getPhysicsData();
                this.ab=this.ad.getBody(this.ad.createBody());
                this.bb=this.bd.getBody(this.bd.createBody());
                this.cb=this.cd.getBody(this.cd.createBody());
                this.ab.setPos(vector2D(0,500));
                this.bb.setPos(vector2D(0,500));
                this.cb.setPos(vector2D(100,500));
                Shapes.reset();
                Shapes.setMass(1);
                Shapes.addCircle(4,0,0);
                this.ab.appendShapes(Shapes);
                Shapes.reset();
                Shapes.setMass(1);
                Shapes.addCircle(1,-1,0);
                Shapes.addCircle(1,1,0);
                this.bb.appendShapes(Shapes);
                Shapes.reset();
                Shapes.setMass(1);
                Shapes.addCircle(1,0,0);
                this.cb.appendShapes(Shapes);
                this.a.setIsEnabled(1);
                this.b.setIsEnabled(1);
                this.c.setIsEnabled(1);
                EntityManager.flush();
            } else if (this.frame==2) {
                local info=this.ad.getCollisionInfo(this.b);
                local list=info.getCollidingShapeIDList();
                local idA=this.bb.getShapeObjectID(0);
                local idB=this.bb.getShapeObjectID(1);
                Probe("intIter.size.active",list.size());
                Probe("intIter.isValid.start",list.isValid());
                local first=list.get();
                Probe("intIter.get.firstKnown",first==idA || first==idB);
                list.goToNext();
                Probe("intIter.goToNext.second",1);
                Probe("intIter.isValid.second",list.isValid());
                local second=-1;
                if (list.isValid()) { second=list.get(); }
                Probe("intIter.get.secondKnown",second==idA || second==idB);
                Probe("intIter.get.distinct",first!=second);
                list.goToNext();
                Probe("intIter.goToNext.end",1);
                Probe("intIter.isValid.end",list.isValid());
                list.reset();
                Probe("intIter.reset.afterEnd",1);
                Probe("intIter.isValid.reset",list.isValid());
                Probe("intIter.get.resetFirst",list.get()==first);
                local empty=this.ad.getCollisionInfo(this.c);
                if (empty==null) {
                    Probe("intIter.size.empty",-1);
                    Probe("intIter.isValid.empty",0);
                } else {
                    local noContacts=empty.getCollidingShapeIDList();
                    Probe("intIter.size.empty",noContacts.size());
                    Probe("intIter.isValid.empty",noContacts.isValid());
                }
                this.frame=3;
                return;
            }
            this.frame+=1;
        });
};
