; Copy this file to the executable's folder as OpenEgg.ini.
; The Linux build reads engine/build/OpenEgg.ini; the Windows build reads
; engine/build-windows/OpenEgg.ini. Paths are always beside the executable.

[system]
; Supported: windows/win32, osx, ps3, ps4, ngp/vita, vitatv (or IDs 0..5).
; OS selection changes which platform-specific GameMonkey branches are used.
os_id = ps3

; Language names or retail IDs 0..19. Default English US = 1.
; ja=0, en_us=1, fr=2, es=3, de=4, it=5, nl=6, pt_pt=7, ru=8, ko=9,
; zh_hant=10, zh_hans=11, fi=12, sv=13, da=14, no=15, pl=16,
; pt_br=17, en_gb=18, es_mx=19.
language = en_us

; Exposes SYSTEM_IsRetailBuild() to scripts.
retail_build = true

; Development-only entitlement simulation for the 15 retail DLC pack IDs.
; This only affects Network_IsDLCAvailable(); it does not provide assets.
debug_all_dlc_available = false

; Optional per-pack desktop availability override (IDs 1..15), e.g. 1, 4, 12.
; This reports availability to scripts only; it does not provide DLC content.
dlc_available_packs =

; Preserve the game's configured aspect ratio and draw black bars when the
; host window has a different aspect ratio. Set false to fill the whole window.
letterbox = true

[network]
; Replacement server root, for example http://127.0.0.1:10061.
; Remote servers require HTTPS for sign-in. Plain HTTP is allowed only for
; loopback development servers. Leave blank to disable requests.
server_url =

; Replacement-server account sign-in. No PSN client setup is needed.
; The server returns a short-lived session after checking these credentials.
; On Unix, OpenEgg restricts this file to owner read/write when it loads the password.
account_email =
account_password =

; Base URL for relative community image keys. Retail uses Amazon S3.
image_base_url = https://s3.amazonaws.com

; PSN Online ID used for this server account. When a ticket is configured,
; OpenEgg checks it against the ticket and the server's stored PSN identity.
; This identity remains fixed if the server display name changes.
psn_online_id =

; Filled from the accepted ticket; retained for later online reports.
psn_country =

; Optional PSN ticket from a retail session. Use either a path or inline hex.
; This sends the ticket to the replacement server; it does not connect to PSN.
; OpenEgg's server requires a valid signature by default. Use generated test
; tickets only with a disposable local test server.
; Treat ticket data as a secret and keep OpenEgg.ini private.
; On Unix, OpenEgg restricts this file to owner read/write when it loads credentials.
psn_ticket_hex =

; Optional existing binary ticket file beside the executable. Leave blank when
; using psn_ticket_hex. OpenEgg restricts this file to owner read/write on Unix;
; keep its Windows file permissions private yourself.
ticket_file =

; Managed by OpenEgg after verified ticket login. This replacement-server
; session is refreshed on use so later launches do not need to contact PSN.
; Treat this file like a password because the session is a bearer credential.
server_session_id =
server_user_id =

; Optional manual session for loopback testing only. OpenEgg rejects these
; values for remote servers. Normal login uses the ticket above. Treat the
; session ID as a password and keep OpenEgg.ini private.
session_id =
user_id =

; Publisher region of your game: SCEA, SCEE, SCEJ, or SCEH.
; The configured language stands in for the unavailable PSN account region.
product_region = SCEA

; Desktop fallback for the PSN chat restriction check. Set false to disable
; community features. This does not change server-side permissions.
community_allowed = true

; Desktop stand-in for the PSN account content-rating check.
; Set true to exercise the restricted-account script path.
account_restricted = false
